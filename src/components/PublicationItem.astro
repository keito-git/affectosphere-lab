---
import type { Publication } from "../data/publications";
import { publicationStage, stages } from "../data/research-map";

interface Props {
  pub: Publication;
  /** When true, hide the submission/published status badge on the right.
   *  Used on the home page where statuses are intentionally suppressed. */
  hideStatus?: boolean;
  locale?: "ja" | "en";
}
const { pub, hideStatus = false, locale = "ja" } = Astro.props;

const kindLabelJa: Record<string, string> = {
  "journal-international": "国際誌",
  "journal-domestic": "国内誌",
  "international-conference": "国際会議",
  "domestic-conference": "国内会議",
  "preprint": "プレプリント",
  "tech-report": "研究報告",
  "other": "その他",
};
const kindLabelEn: Record<string, string> = {
  "journal-international": "International Journal",
  "journal-domestic": "Domestic Journal",
  "international-conference": "International Conference",
  "domestic-conference": "Domestic Conference",
  "preprint": "Preprint",
  "tech-report": "Technical Report",
  "other": "Other",
};
const categoryLabel =
  locale === "en" ? kindLabelEn[pub.kind] : kindLabelJa[pub.kind];

const stageId = publicationStage[pub.slug];
const stage = stages.find((s) => s.id === stageId);

// Figures as recorded on acceptance in the PI's publication list. Nothing is
// inferred: an entry without a figure simply shows none.
const metrics = [pub.impact, pub.sjr ? `SJR ${pub.sjr}` : null, pub.rank ? `Rank ${pub.rank}` : null]
  .filter(Boolean) as string[];

const [y, m] = pub.date.split("-");
const monthsEn = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
const dateLabel =
  locale === "en"
    ? `${monthsEn[Number(m) - 1]} ${y}`
    : `${y}年${Number(m)}月`;
---

<li
  class="reveal flex flex-col gap-3 border-b border-stone py-6 last:border-b-0 md:flex-row md:items-start md:justify-between md:gap-8"
  data-pub-kind={pub.kind}
  data-pub-stage={stageId ?? "unplaced"}
>
  <div class="flex-1">
    <div class="mb-2 flex flex-wrap items-center gap-3">
      <span class="inline-block bg-amber/15 px-2 py-0.5 text-[0.7rem] font-medium tracking-wide text-amber-deep">
        {categoryLabel}
      </span>
      {pub.award && (
        <span class="inline-block border border-amber-deep/40 px-2 py-0.5 font-label text-[0.66rem] uppercase tracking-[0.1em] text-amber-deep">
          {pub.award}
        </span>
      )}
      {stage && (
        <span class="font-label text-[0.68rem] uppercase tracking-[0.12em] text-slate">
          {stage.label}
          {locale === "ja" && <span class="ml-1.5 font-display normal-case tracking-normal">{stage.labelJa}</span>}
        </span>
      )}
    </div>
    <p class="font-display text-xl leading-snug text-charcoal">
      {pub.href ? (
        <a
          href={pub.href}
          class="link-amber"
          target="_blank"
          rel="noopener noreferrer"
        >
          {pub.title}
          <span class="ml-1 align-middle text-[0.7em] text-slate" aria-hidden="true">&#8599;</span>
          <span class="sr-only">{locale === "en" ? "(opens the publisher page)" : "（出版社ページを開きます）"}</span>
        </a>
      ) : (
        pub.title
      )}
    </p>
    <p class="mt-2 font-sans text-sm text-slate">{pub.authors}</p>
    <p class="mt-1 flex flex-wrap items-center gap-x-2 font-sans text-sm text-slate">
      <span>{pub.venue}</span>
      <span class="text-stone">&middot;</span>
      <span>{dateLabel}</span>
      {metrics.length > 0 && (
        <>
          <span class="text-stone">&middot;</span>
          <span class="font-label text-[0.72rem] tracking-[0.08em] text-amber-deep">
            {metrics.join(" / ")}
          </span>
        </>
      )}
    </p>
  </div>
  {pub.status && !hideStatus && (
    <div class="md:pt-1 md:text-right">
      <span class="font-sans text-[0.75rem] uppercase tracking-[0.14em] text-amber-deep font-medium">
        {pub.status}
      </span>
    </div>
  )}
</li>
