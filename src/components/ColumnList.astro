---
// Column index: one post per row. Thumbnail on the left, then date and
// reading time, external links, title and excerpt.
import type { CollectionEntry } from "astro:content";
import { webp, webpSrcset, intrinsic } from "../lib/images";

interface Props {
  posts: (CollectionEntry<"column-ja"> | CollectionEntry<"column-en">)[];
  hrefBase: string;
  locale?: "ja" | "en";
}

const { posts, hrefBase, locale = "ja" } = Astro.props;

const MONTHS = ["January", "February", "March", "April", "May", "June", "July",
  "August", "September", "October", "November", "December"];

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  return locale === "en"
    ? `${MONTHS[Number(m) - 1]} ${Number(d)}, ${y}`
    : `${y}年${Number(m)}月${Number(d)}日`;
}
---

<ul class="divide-y divide-stone border-y border-stone">
  {
    posts.map((post) => {
      const art = post.data.image;
      const dim = art ? intrinsic(art) : { width: null, height: null };
      const href = `${hrefBase}/${post.slug}/`;
      return (
        <li class:list={["reveal grid gap-6 py-10 md:gap-10", art && "md:grid-cols-[minmax(0,18rem)_1fr]"]}>
          {art ? (
            <a href={href} class="block" tabindex="-1" aria-hidden="true">
              <img
                src={webp(art, 800)}
                srcset={webpSrcset(art)}
                sizes="(min-width: 768px) 18rem, 100vw"
                width={dim.width ?? undefined}
                height={dim.height ?? undefined}
                alt=""
                class="aspect-[16/10] w-full border border-stone object-cover"
                loading="lazy"
                decoding="async"
              />
            </a>
          ) : null}
          <div class="min-w-0">
            <p class="font-label text-[0.72rem] uppercase tracking-[0.14em] text-slate">
              {formatDate(post.data.date)} · {post.data.readingMinutes} min read
            </p>
            {post.data.links && post.data.links.length > 0 && (
              <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-heading text-sm">
                {post.data.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer" class="link-amber">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
            <h2 class="mt-3 font-display text-xl font-medium leading-snug text-charcoal md:text-2xl">
              <a href={href} class="hover:text-deepslate">{post.data.title}</a>
            </h2>
            {post.data.subtitle && (
              <p class="mt-1 font-display text-base text-slate">{post.data.subtitle}</p>
            )}
            <p class="mt-4 font-display text-base leading-relaxed text-charcoal/85">
              {post.data.excerpt}
            </p>
          </div>
        </li>
      );
    })
  }
</ul>
