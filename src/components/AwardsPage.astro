---
// "Awards": research awards first, then contests and the rest. Every award
// reads the same way whether or not a certificate survives, so the list is
// uniform and the certificate opens on demand: entries that have one carry a
// button that shows the document at full size. No totals or count charts.
import { awardGroups as groupsJa } from "../data/awards";
import { awardGroups as groupsEn } from "../data/awards.en";
import { webp } from "../lib/images";

interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const isEn = locale === "en";

const groups = isEn ? groupsEn : groupsJa;

const copy = isEn
  ? {
      eyebrow: "Awards",
      heading: "Awards",
      lead: "Awards for research papers and conference work, and awards from business contests and other programmes. Where a certificate survives, a button opens it at full size.",
      titles: {
        research: "Research awards",
        contest: "Contests and other awards",
      } as Record<string, string>,
      cert: "View certificate",
      open: (t: string) => `Open the certificate for ${t} at full size`,
      close: "Close",
    }
  : {
      eyebrow: "Awards",
      heading: "受賞",
      lead: "論文・学会での研究の受賞と、ビジネスコンテストなどでの受賞を並べている。賞状が手元にあるものは、ボタンから大きく表示できる。",
      titles: {
        research: "研究の受賞",
        contest: "コンテスト・そのほかの受賞",
      } as Record<string, string>,
      cert: "賞状を見る",
      open: (t: string) => `${t} の賞状を大きく表示する`,
      close: "閉じる",
    };

// Certificates are a mix of landscape and portrait scans, so the viewer shows
// each one whole on a mat rather than cropping it to a common box.
function formatYM(iso: string): string {
  const [y, m] = iso.split("-");
  return `${y}.${m}`;
}
---

<!-- Header on the dark observation surface, as on the other sections. -->
<section class="surface-ink relative overflow-hidden" aria-labelledby="awards-heading">
  <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-content page-x pb-12 pt-16 md:pb-16 md:pt-20">
    <p class="eyebrow reveal">{copy.eyebrow}</p>
    <h1
      id="awards-heading"
      class="reveal mt-5 font-display font-semibold tracking-tight text-[#F4F2ED]"
      style="font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1;"
    >
      {copy.heading}
    </h1>
    <p
      class="reveal mt-8 max-w-[72rem] font-display text-[#CFCBC2]"
      style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
    >
      {copy.lead}
    </p>
  </div>
</section>

{
  groups.map((group, gi) => (
    <section
      class="mx-auto mt-section max-w-content page-x"
      aria-labelledby={`award-group-${group.key}`}
    >
      <header class="reveal">
        <p class="eyebrow">
          {String(gi + 1).padStart(2, "0")} &mdash; {group.label}
        </p>
        <h2
          id={`award-group-${group.key}`}
          class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
        >
          {copy.titles[group.key] ?? group.label}
        </h2>
      </header>

      <ul class="mt-10">
        {group.items.map((a) => (
          <li class="reveal grid gap-x-8 gap-y-3 border-b border-stone py-7 md:grid-cols-[10rem_minmax(0,1fr)_auto] md:items-start">
            <div class="flex flex-row flex-wrap items-center gap-x-3 gap-y-2 md:flex-col md:items-start">
              <span class="font-label text-[0.72rem] tabular-nums tracking-[0.12em] text-slate">
                {formatYM(a.date)}
              </span>
              {a.rank && (
                <span class="border border-amber/60 bg-amber/15 px-2 py-0.5 font-sans text-[0.76rem] leading-snug text-amber-deep">
                  {a.rank}
                </span>
              )}
            </div>

            <div class="min-w-0">
              <h3 class="font-display text-lg leading-snug text-charcoal md:text-xl">{a.title}</h3>
              {a.paperTitle && (
                <p class="mt-2.5 border-l border-stone pl-3 font-display text-sm leading-relaxed text-charcoal/85 md:text-base">
                  {a.paperTitle}
                </p>
              )}
              {a.paperAuthors && (
                <p class="mt-1.5 pl-3 font-sans text-xs leading-relaxed text-slate md:text-sm">
                  {a.paperAuthors}
                </p>
              )}
            </div>

            {a.image && (
              <button
                type="button"
                class="inline-flex shrink-0 items-center gap-2 justify-self-start border border-stone bg-ivory px-3 py-2 font-sans text-[0.78rem] text-slate transition-colors hover:border-amber hover:text-amber-deep focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber"
                data-cert={webp(a.image, 1600)}
                data-cert-alt={a.title}
                aria-label={copy.open(a.title)}
              >
                <svg width="13" height="15" viewBox="0 0 13 15" fill="none" aria-hidden="true">
                  <path d="M1 1h7l4 4v9H1z" stroke="currentColor" stroke-width="1" />
                  <path d="M8 1v4h4" stroke="currentColor" stroke-width="1" />
                  <circle cx="6.5" cy="9" r="2" stroke="#C4974A" stroke-width="1" />
                </svg>
                {copy.cert}
              </button>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))
}

<!-- Full-size view of a certificate. A native <dialog>, so Esc and focus
     handling come from the browser. -->
<dialog
  class="w-[min(92vw,70rem)] border border-stone bg-ivory p-0 backdrop:bg-ink/80"
  data-cert-dialog
>
  <form method="dialog" class="flex items-center justify-between gap-4 border-b border-stone px-4 py-3">
    <p class="min-w-0 truncate font-display text-sm text-charcoal" data-cert-title></p>
    <button
      type="submit"
      class="shrink-0 border border-stone px-3 py-1 font-sans text-xs text-slate transition-colors hover:border-charcoal hover:text-charcoal"
    >
      {copy.close}
    </button>
  </form>
  <div class="bg-cream p-4">
    <img alt="" class="mx-auto max-h-[78vh] w-auto max-w-full object-contain" data-cert-image />
  </div>
</dialog>

<div class="h-section-sm" aria-hidden="true"></div>

<script>
  // Click a certificate to see it whole. The cards keep working without this:
  // without the script the dialog simply never opens.
  const dialog = document.querySelector<HTMLDialogElement>("[data-cert-dialog]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-cert-image]");
  const title = dialog?.querySelector<HTMLElement>("[data-cert-title]");

  if (dialog && image) {
    document.querySelectorAll<HTMLButtonElement>("[data-cert]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.dataset.cert ?? "";
        const alt = btn.dataset.certAlt ?? "";
        image.src = src;
        image.alt = alt;
        if (title) title.textContent = alt;
        dialog.showModal();
      });
    });

    // Clicking the backdrop (i.e. outside the dialog's own box) closes it.
    dialog.addEventListener("click", (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    // Drop the source on close so a large certificate is not kept decoded.
    dialog.addEventListener("close", () => {
      image.removeAttribute("src");
    });
  }
</script>
