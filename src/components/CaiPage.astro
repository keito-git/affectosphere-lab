<script>
  // The dissection: picking a depth lights the layer that becomes visible and
  // rewrites the readout beside it. Every word on the panel is rendered by the
  // page; the script only moves numbers and opacities.
  const root = document.querySelector<HTMLElement>("[data-cai-depth]");
  if (root && root.dataset.payload) {
    const data = JSON.parse(root.dataset.payload) as {
      barMax: number;
      base: number[];
      depths: { bars: number[] | null; delta: boolean }[];
    };
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-depth]"));
    const copy = chips.map((c) => c.dataset.copy ?? "");
    const LAYERS: Record<string, number[]> = {
      // opacity of each drawn layer, per depth
      net: [0.12, 1, 1, 1],
      lit: [0.12, 0.45, 1, 1],
      probe: [0, 0, 1, 0.35],
      dial: [0, 0, 0, 1],
    };

    function show(i: number) {
      const d = data.depths[i];
      if (!d) return;

      Object.entries(LAYERS).forEach(([name, values]) => {
        const g = root!.querySelector<SVGGElement>(`[data-layer="${name}"]`);
        if (g) g.setAttribute("opacity", String(values[i]));
      });

      const text = JSON.parse(copy[i] || "{}") as { title?: string; sees?: string; asks?: string };
      (["title", "sees", "asks"] as const).forEach((key) => {
        const el = root!.querySelector<HTMLElement>(`[data-d="${key}"]`);
        if (el && text[key]) el.textContent = text[key] as string;
      });

      const empty = root!.querySelector<HTMLElement>('[data-d="empty"]');
      const wrap = root!.querySelector<HTMLElement>('[data-d="bars-wrap"]');
      if (empty) empty.hidden = d.bars !== null;
      if (wrap) wrap.hidden = d.bars === null;
      if (!d.bars) return;

      d.bars.forEach((q, k) => {
        const bar = root!.querySelector<HTMLElement>(`[data-bar="${k}"]`);
        if (bar) bar.style.width = Math.max(1, (q / data.barMax) * 100) + "%";
        const val = root!.querySelector<HTMLElement>(`[data-val="${k}"]`);
        if (val) val.textContent = q.toFixed(2);
        const del = root!.querySelector<HTMLElement>(`[data-delta="${k}"]`);
        if (del) {
          const diff = q - data.base[k];
          del.textContent = d.delta && Math.abs(diff) >= 0.005
            ? (diff > 0 ? "+" : "−") + Math.abs(diff).toFixed(2)
            : "";
        }
      });
      chips.forEach((chip, k) => chip.setAttribute("aria-pressed", k === i ? "true" : "false"));
    }

    chips.forEach((chip, i) => {
      chip.addEventListener("click", () => show(i));
      chip.addEventListener("mouseenter", () => show(i));
    });
    show(0);
  }
</script>

<script>
  // The tilt: picking a state re-renders one next-word distribution. The page
  // has already computed every state; the script only swaps numbers in.
  const root = document.querySelector<HTMLElement>("[data-cai-tilt]");
  if (root && root.dataset.payload) {
    const data = JSON.parse(root.dataset.payload) as {
      barMax: number;
      base: number[];
      states: { prob: number[]; top: number; width: number }[];
    };
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-state]"));
    const names = Array.from(root.querySelectorAll<HTMLElement>("[data-bar]")).map(
      (b) => b.closest("li")?.querySelector("span")?.textContent ?? "",
    );
    const slot = (n: string) => root.querySelector<HTMLElement>(`[data-t="${n}"]`);

    function show(i: number) {
      const st = data.states[i];
      if (!st) return;
      st.prob.forEach((q, k) => {
        const bar = root!.querySelector<HTMLElement>(`[data-bar="${k}"]`);
        if (bar) bar.style.width = Math.max(1, (q / data.barMax) * 100) + "%";
        const val = root!.querySelector<HTMLElement>(`[data-val="${k}"]`);
        if (val) val.textContent = q.toFixed(2);
        const del = root!.querySelector<HTMLElement>(`[data-delta="${k}"]`);
        if (del) {
          const diff = q - data.base[k];
          del.textContent = i > 0 && Math.abs(diff) >= 0.005
            ? (diff > 0 ? "+" : "−") + Math.abs(diff).toFixed(2)
            : "";
        }
      });
      const top = slot("top");
      if (top) top.textContent = names[st.top];
      const topname = slot("topname");
      if (topname) topname.textContent = names[st.top];
      const topp = slot("topp");
      if (topp) topp.textContent = st.prob[st.top].toFixed(2);
      const width = slot("width");
      if (width) width.textContent = st.width.toFixed(1);
      chips.forEach((c, k) => c.setAttribute("aria-pressed", k === i ? "true" : "false"));
    }

    chips.forEach((c, i) => {
      c.addEventListener("click", () => show(i));
      c.addEventListener("mouseenter", () => show(i));
    });
    show(0);
  }
</script>
