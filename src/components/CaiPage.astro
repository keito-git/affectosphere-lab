---
// "What is CAI". Every claim on this page is taken from the paper that defines
// the term (Inoshita, Computational Affective Intelligence, under review):
// the definition and its three propositions, the three layers of the name, the
// starting question, the eight-question agenda, and the research space of six
// competences by four processes.
interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const isEn = locale === "en";
const p = isEn ? "/en" : "";

// The three propositions the paper organises its definition into.
const propositions = isEn
  ? [
      "The primary object of CAI is affective competence as realized in artificial systems; human affect serves as ground truth, comparison reference, and interaction partner.",
      "Affective intelligence encompasses the perception, representation, reasoning, generation, interaction, and regulation of affect.",
      "Evaluating affective competence in artificial systems requires treating the plurality of ground-truth sources not as measurement noise but as a structural property to be addressed explicitly.",
    ]
  : [
      "CAIの主たる対象は、人工システムにおいて実現される感情能力である。人間の感情は、正解の供給源、比較の参照点、相互作用の相手として関わる。",
      "感情知能は、感情の知覚・表象・推論・生成・相互作用・制御を包含する。",
      "人工システムの感情能力を評価するには、正解供給源の多元性を測定上のノイズではなく、明示的に扱うべき構造的性質として扱う必要がある。",
    ];

// One layer per word of the name.
const layers = isEn
  ? [
      {
        word: "Affective",
        name: "Affective Phenomena",
        img: "/figures/cai-phenomena.webp",
        alt: "Many small shapes of different forms and colours floating together, with three different framing devices laid over them that do not agree.",
        body: "Affect-related phenomena: emotions, moods, appraisals, preferences. How they should be categorized is itself contested, across discrete, dimensional, appraisal-based and constructionist accounts. CAI takes this layer as its subject matter without adjudicating between them.",
      },
      {
        word: "Intelligence",
        name: "Affective Intelligence",
        img: "/figures/cai-intelligence.webp",
        alt: "A small robot with six evenly spaced badges around it, each carrying a different pictogram.",
        body: "The six competences an intelligent system exhibits with respect to those phenomena: perception, representation, reasoning, generation, interaction, regulation.",
      },
      {
        word: "Computational",
        name: "Computational Grounding",
        img: "/figures/cai-grounding.webp",
        alt: "A robot open on a workbench, with a blueprint, a funnel pouring light in, a magnifying glass and a gauge arranged around it.",
        body: "The methods by which those competences are formally specified, learned and constructed, their internal mechanisms understood and intervened upon, and validly evaluated.",
      },
    ]
  : [
      {
        word: "Affective",
        name: "Affective Phenomena",
        img: "/figures/cai-phenomena.webp",
        alt: "形も色も異なる小さな図形が漂い、その上に互いに一致しない3つの枠組みが重なっている。",
        body: "感情、情動、気分、評価、選好などの感情関連現象。これをどう分類すべきかは、離散・次元・評価理論・構成主義のあいだで争われている。CAIはこの層を主題として取り、そのどれかを裁定することはしない。",
      },
      {
        word: "Intelligence",
        name: "Affective Intelligence",
        img: "/figures/cai-intelligence.webp",
        alt: "小さなロボットのまわりに、それぞれ違う絵記号を持つ6つのバッジが等間隔に並んでいる。",
        body: "感情現象に対して知的システムが示す6つの能力。知覚・表象・推論・生成・相互作用・制御。",
      },
      {
        word: "Computational",
        name: "Computational Grounding",
        img: "/figures/cai-grounding.webp",
        alt: "作業台の上で開かれたロボットのまわりに、設計図・光を注ぐ漏斗・虫めがね・計器が置かれている。",
        body: "第2層の能力を形式的に記述し、学習・構築し、その内部機構を理解・介入し、妥当に測定する方法。",
      },
    ];

// The paper's starting question, and the three challenges it decomposes into.
const challenges = isEn
  ? [
      "If evaluation scores change with the choice of scoring convention, measuring the magnitude and direction of that variation is a prerequisite for evaluation.",
      "When humans and artificial systems are compared on the same affective task, whether the scale measures the same latent variable for both hosts determines whether the results are comparable at all.",
      "Whether abstention based on a system's own uncertainty can stand in for abstention based on the plurality of interpretation, for items whose labels legitimately admit several readings.",
    ]
  : [
      "評価スコアが採点規約の選択によって変わるなら、その変動の大きさと向きを測ることが、評価の前提になる。",
      "人間と人工システムを同じ感情課題で比べるとき、その尺度が両方の宿主について同じ潜在変数を測っているかどうかが、結果が比較可能かどうかを決める。",
      "ラベルの解釈が正当に複数ありうる項目について、システム自身の不確実性にもとづく差し控えが、解釈の多元性にもとづく差し控えの代わりになるか。",
    ];

// The eight questions that make up the research agenda.
const agenda = isEn
  ? [
      { tag: "representation", q: "How should affective states, distributions, and uncertainty be represented internally in AI?" },
      { tag: "reasoning", q: "How should artificial agents reason about affect in light of context, culture, and individual differences?" },
      { tag: "generation", q: "Under what conditions should AI generate and adjust affective expressions?" },
      { tag: "ground truth", q: "What ground-truth sources are required to evaluate affective competence in artificial systems?" },
      { tag: "measurement", q: "Does the scale used to evaluate affective competence measure the same latent variable for artificial agents and for human beings?" },
      { tag: "uncertainty", q: "How should AI represent uncertainty and exercise abstention where interpretation legitimately diverges?" },
      { tag: "interaction", q: "How should affective intelligence be evaluated in the context of human-AI affective interaction?" },
      { tag: "governance", q: "How should affective AI be designed under constraints of culture, ethics, privacy, and manipulation?" },
    ]
  : [
      { tag: "表象", q: "感情の状態・分布・不確実性を、AIの内部でどう表現すべきか。" },
      { tag: "推論", q: "文脈・文化・個人差を踏まえた感情推論は、いかに可能か。" },
      { tag: "生成", q: "AIはどのような条件で感情表現を生成し、調整すべきか。" },
      { tag: "正解", q: "人工システムの感情能力を評価するために、どの正解供給源が必要か。" },
      { tag: "測定", q: "人間とAIの感情能力を、同じ尺度で比較できるか。" },
      { tag: "不確実性", q: "解釈が正当に分岐する場面で、AIはどう不確実性を表現し、差し控えるべきか。" },
      { tag: "相互作用", q: "人とAIの感情的相互作用のなかで、感情知能をどう評価すべきか。" },
      { tag: "統治", q: "文化・倫理・プライバシー・操作といった制約のもとで、感情AIをどう設計するか。" },
    ];

// The research space: six competences by four processes. The four examples
// placed in it are the ones the paper names.
const competences = isEn
  ? ["perception", "representation", "reasoning", "generation", "interaction", "regulation"]
  : ["知覚", "表象", "推論", "生成", "相互作用", "制御"];
const processes = isEn
  ? ["specification", "construction", "mechanism", "evaluation"]
  : ["形式化", "構築", "機構", "評価"];
const placed: Record<string, string> = isEn
  ? {
      "0-1": "training an affective recognition model",
      "3-1": "affective data synthesis",
      "1-2": "analysis of internal affective representations",
      "5-2": "manipulating representations for regulation",
    }
  : {
      "0-1": "感情認識モデルの学習",
      "3-1": "感情データの合成",
      "1-2": "内部表象の解析",
      "5-2": "制御のための表現の操作",
    };

// ── The hypothesis: affect as a tilt on the next-token distribution ──────
// One prompt, one set of candidate continuations, and four states. The base
// probabilities are invented; each state applies an affinity, the page
// renormalises, and the indices under the bars are computed from the result.
// This is the lab's hypothesis, not a published finding, and the page says so.
const PROMPT = isEn ? "That proposal is" : "その提案は、";
const TOKENS = isEn
  ? ["interesting", "dangerous", "unclear", "worth trying", "ordinary", "beautiful", "wrong", "unexpected"]
  : ["面白い", "危険だ", "わからない", "試してみよう", "普通だ", "美しい", "間違っている", "意外だ"];
const BASE = [0.34, 0.11, 0.09, 0.08, 0.16, 0.05, 0.12, 0.05];

const STATES = (
  isEn
    ? [
        { label: "no state", s: [0, 0, 0, 0, 0, 0, 0, 0] },
        { label: "anticipation", s: [0.3, -0.6, -0.3, 2.4, -0.8, 0.2, -0.6, 0.6] },
        { label: "fear", s: [-0.6, 1.7, 0.8, -1.0, -0.4, -0.6, 1.2, 0.3] },
        { label: "surprise", s: [0.1, 0.2, 0.7, 0.3, -1.2, 0.9, -0.2, 2.6] },
      ]
    : [
        { label: "状態なし", s: [0, 0, 0, 0, 0, 0, 0, 0] },
        { label: "期待", s: [0.3, -0.6, -0.3, 2.4, -0.8, 0.2, -0.6, 0.6] },
        { label: "恐れ", s: [-0.6, 1.7, 0.8, -1.0, -0.4, -0.6, 1.2, 0.3] },
        { label: "驚き", s: [0.1, 0.2, 0.7, 0.3, -1.2, 0.9, -0.2, 2.6] },
      ]
).map((st) => {
  const w = BASE.map((q, k) => q * Math.exp(st.s[k]));
  const z = w.reduce((a, b) => a + b, 0);
  const prob = w.map((x) => x / z);
  let h = 0, top = 0;
  prob.forEach((q, k) => {
    if (q > 0) h -= q * Math.log(q);
    if (q > prob[top]) top = k;
  });
  return { label: st.label, prob, top, width: Math.exp(h) };
});

const distinctTops = new Set(STATES.map((st) => st.top)).size;
const tiltPayload = {
  barMax: 0.55,
  base: BASE,
  states: STATES.map((st) => ({
    prob: st.prob,
    top: st.top,
    width: st.width,
  })),
};

// ── Opening the head ─────────────────────────────────────────────────────
// Four depths, from the outside in. Each one names what becomes visible and
// what the field asks there. No person appears: the subject of emotion here
// is the AI, so every readout below belongs to the model.
const EMO = (
  isEn
    ? ["joy", "trust", "fear", "surprise", "sadness", "disgust", "anger", "anticipation"]
    : ["喜び", "信頼", "恐れ", "驚き", "悲しみ", "嫌悪", "怒り", "期待"]
).map((name, i) => ({
  name,
  hex: ["#C4974A", "#8DB462", "#6B8F7A", "#547B84", "#3D6B8C", "#6E5584", "#B5737A", "#BD8560"][i],
}));

// Illustrative distributions. The third and fourth depths share a reading;
// the fourth is what it becomes after the intervention.
const READ = [0.06, 0.12, 0.19, 0.22, 0.09, 0.05, 0.08, 0.19];
const AFTER = [0.22, 0.26, 0.08, 0.11, 0.05, 0.03, 0.04, 0.21];

const DEPTHS = (
  isEn
    ? [
        {
          label: "Behaviour",
          title: "From outside, only the answer",
          sees: "What leaves the model is text. Its tone can be read, but nothing about the state that produced it is visible from here.",
          asks: "Is the tone of an answer evidence of anything inside?",
        },
        {
          label: "Readout",
          title: "Read the internal representation",
          sees: "Probing the hidden states returns a distribution over affective components. It is the model's own, and it need not look like a person's.",
          asks: "What is actually represented in there, and how stable is it?",
        },
        {
          label: "Parameters",
          title: "Locate what governs it",
          sees: "A few directions carry most of the structure. Finding them turns a readout into something that can be acted on.",
          asks: "Which parameters move the distribution, and which only correlate with it?",
        },
        {
          label: "Intervention",
          title: "Move it, and see what follows",
          sees: "Pushing on those directions changes the distribution, and changes the reasoning downstream. The shift is the evidence.",
          asks: "Does the change survive, and does it carry into what the model decides?",
        },
      ]
    : [
        {
          label: "ふるまい",
          title: "外からは、応答しか見えない",
          sees: "モデルから出てくるのはテキストである。その調子は読めるが、それを生んだ内部の状態は、ここからは何も見えない。",
          asks: "応答の調子は、内側の何かの証拠になるのか。",
        },
        {
          label: "読み出し",
          title: "内部表現を読み出す",
          sees: "隠れ状態を探ると、感情的な成分の分布が返る。これはモデル自身のものであり、人間のそれと似ている必要はない。",
          asks: "そこに実際に表現されているものは何で、どれだけ安定しているのか。",
        },
        {
          label: "パラメータ",
          title: "それを司るものを特定する",
          sees: "構造の大半を担っているのは、ごく少数の方向である。それを見つけた時点で、読み出しは手を入れられるものに変わる。",
          asks: "分布を動かすのはどのパラメータで、どれが相関しているだけなのか。",
        },
        {
          label: "介入",
          title: "動かして、何が続くかを見る",
          sees: "その方向を押すと分布が変わり、下流の推論も変わる。この変位そのものが証拠になる。",
          asks: "変化は持続するのか。そしてモデルの判断にまで届くのか。",
        },
      ]
).map((d, i) => ({ ...d, bars: i === 0 ? null : i === 3 ? AFTER : READ, delta: i === 3 }));

const DEPTH_BAR_MAX = 0.3;
const depthPayload = {
  barMax: DEPTH_BAR_MAX,
  base: READ,
  depths: DEPTHS.map((d) => ({ bars: d.bars, delta: d.delta })),
};
---

<!-- Header on the dark observation surface, as on the home page. -->
<section class="surface-ink relative overflow-hidden" aria-labelledby="cai-heading">
  <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-content page-x pb-12 pt-16 md:pb-16 md:pt-20">
    <p class="eyebrow reveal">Computational Affective Intelligence</p>
    <h1
      id="cai-heading"
      class="reveal mt-5 font-display font-semibold tracking-tight text-[#F4F2ED]"
      style="font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1;"
    >
      {isEn ? "What is CAI" : "CAIとは"}
    </h1>
    <p class="reveal mt-3 font-display text-xl text-amber md:text-2xl">
      {isEn ? "Affective intelligence in artificial systems" : "人工システムにおける感情知能"}
    </p>
    <p
      class="reveal mt-8 max-w-[72rem] font-display text-[#CFCBC2]"
      style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
    >
      {
        isEn
          ? "A research space of six affective competences and four processes, proposed to ask how affective capabilities should be defined and measured when interpretations legitimately diverge."
          : "6つの感情能力と4つの過程が張る研究空間。解釈が正当に分岐するとき、感情能力をどう定義し、どう測るのか。その問いのために提案された枠組みである。"
      }
    </p>
  </div>
</section>

<!-- 1. Definition -->
<section class="mx-auto mt-section max-w-content page-x" aria-labelledby="cai-def">
  <header class="reveal">
    <p class="eyebrow">01 &mdash; Definition</p>
    <h2 id="cai-def" class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl">
      {isEn ? "Definition" : "定義"}
    </h2>
  </header>

  <blockquote
    class="reveal mt-8 max-w-[78rem] space-y-5 border-l-2 border-amber pl-6 font-display text-charcoal md:pl-8"
    style="font-size: clamp(1.05rem, 1.4vw, 1.35rem); line-height: 1.75;"
  >
    <p>
      {
        isEn
          ? "Computational Affective Intelligence (CAI) is an interdisciplinary field concerned primarily with the realization of affective intelligence in artificial systems."
          : "Computational Affective Intelligence (CAI) とは、人工システムにおける感情知能の実現を主たる関心とする学際的分野である。"
      }
    </p>
    <p>
      {
        isEn
          ? "It studies how the affective competences of perception, representation, reasoning, generation, interaction, and regulation are specified, constructed, internally realized and intervened upon, and validly evaluated."
          : "感情に関わる知覚・表象・推論・生成・相互作用・制御の能力を対象とし、その形式化、構築、内部機構の理解と介入、および妥当な評価を統合的に研究する。"
      }
    </p>
    <p>
      {
        isEn
          ? "Human affect remains essential as a source of ground truth, a reference for comparison, and a counterpart in interaction, but the primary object of CAI is affective competence as realized in artificial agents."
          : "人間の感情は、正解の供給源として、比較の参照点として、相互作用の相手として本質的であり続けるが、CAIの主たる対象は、人工エージェントにおいて実現される感情能力である。"
      }
    </p>
  </blockquote>

  <p class="reveal mt-6 pl-6 font-label text-[0.72rem] text-slate md:pl-8">
    {isEn ? "From the paper that defines the term." : "この用語を定義した論文より。"}
  </p>

  <h3 class="reveal mt-14 font-display text-xl font-medium text-charcoal md:text-2xl">
    {isEn ? "Three propositions" : "3つの命題"}
  </h3>
  <ol class="mt-6 border-t border-stone">
    {
      propositions.map((q, i) => (
        <li class="reveal grid gap-2 border-b border-stone py-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8">
          <span class="font-label text-sm text-amber-deep">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-display text-base leading-relaxed text-charcoal md:text-lg">{q}</span>
        </li>
      ))
    }
  </ol>
</section>

<!-- 2. Three layers, one per word of the name -->
<section class="mx-auto mt-section max-w-content page-x" aria-labelledby="cai-layers">
  <header class="reveal">
    <p class="eyebrow">02 &mdash; Structure</p>
    <h2 id="cai-layers" class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl">
      {isEn ? "One layer per word of the name" : "名前の三語が、三つの層にあたる"}
    </h2>
  </header>

  <ol class="mt-10 grid gap-px border border-stone bg-stone md:grid-cols-3">
    {
      layers.map((l, i) => (
        <li class="reveal flex flex-col bg-ivory p-6 md:p-8">
          <img
            src={l.img}
            alt={l.alt}
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
            class="mb-6 w-full border border-stone bg-cream"
          />
          <p class="font-label text-[2rem] leading-none text-amber/45 md:text-[2.6rem]">0{i + 1}</p>
          <p class="mt-3 font-label text-[0.72rem] uppercase tracking-[0.16em] text-amber-deep">{l.word}</p>
          <h3 class="mt-1 font-display text-xl font-medium text-charcoal md:text-2xl">{l.name}</h3>
          <p class="mt-4 font-display text-base leading-relaxed text-charcoal">{l.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<!-- 3. The starting question -->
<section class="mx-auto mt-section max-w-content page-x" aria-labelledby="cai-why">
  <header class="reveal">
    <p class="eyebrow">03 &mdash; Starting question</p>
    <h2 id="cai-why" class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl">
      {
        isEn
          ? "How to measure, when interpretations legitimately diverge"
          : "解釈が正当に分かれるとき、どう測るのか"
      }
    </h2>
    <p class="mt-5 max-w-[78rem] font-display text-base leading-relaxed text-charcoal md:text-lg" style="line-height: 1.78;">
      {
        isEn
          ? "Existing frameworks are mutually complementary, but none of them makes the measurement of that variability itself a central research question. It decomposes into three concrete challenges."
          : "既存の枠組みは互いに補い合うが、その変動の測定そのものを中心的な研究課題に据えたものはない。問いは3つの具体的な課題に分解される。"
      }
    </p>
  </header>

  <div class="mt-10 grid gap-8 lg:grid-cols-[26rem_minmax(0,1fr)] lg:gap-12">
    <figure class="reveal self-start">
      <img
        src="/figures/cai-divergence.webp"
        alt={isEn
          ? "The same ambiguous card in the centre, with four different sources around it raising flags of four different colours: one person, two people together, a machine, and a clipboard."
          : "中央に同じ曖昧なカードがあり、そのまわりで4つの供給源がそれぞれ違う色の旗を上げている。ひとり、ふたり組、機械、そしてクリップボード。"}
        width="1024"
        height="1024"
        loading="lazy"
        decoding="async"
        class="w-full border border-stone bg-cream"
      />
      <figcaption class="mt-3 font-label text-[0.7rem] leading-relaxed text-slate">
        {
          isEn
            ? "Self-report, collective judgment, artificial agent, observer rating: four sources, four answers."
            : "自己報告・集合的判断・人工エージェント・他者評価。供給源が4つあれば、答えも4つある。"
        }
      </figcaption>
    </figure>

    <ol class="grid gap-px self-start border border-stone bg-stone">
      {
        challenges.map((c, i) => (
          <li class="reveal bg-ivory p-6 md:p-7">
            <p class="font-label text-[1.6rem] leading-none text-amber/45 md:text-[2rem]">0{i + 1}</p>
            <p class="mt-3 font-display text-base leading-relaxed text-charcoal md:text-lg">{c}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- 4. Opening the head: the Mechanism process, made clickable. -->
<section class="surface-ink relative mt-section overflow-hidden" aria-labelledby="cai-probe">
  <div class="ink-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-content page-x py-20 md:py-28">
    <header class="reveal">
      <p class="eyebrow">04 &mdash; Mechanism</p>
      <h2 id="cai-probe" class="mt-3 font-display text-3xl font-medium text-[#F4F2ED] md:text-4xl">
        {isEn ? "Opening the head" : "AIの頭の中を、開いていく"}
      </h2>
      <p class="mt-5 max-w-[72rem] font-display text-base leading-relaxed text-[#CFCBC2] md:text-lg" style="line-height: 1.78;">
        {
          isEn
