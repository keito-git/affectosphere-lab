---
import TownScene from "./TownScene.astro";
import TownPanels from "./TownPanels.astro";

interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const isEn = locale === "en";

// The claim at the top of the site: what the lab sets out to do, named as an
// action rather than as a rank, with the field it belongs to stated underneath.
const headlineEra = isEn ? "For the Affectosphere era," : "Affectosphere時代に、";
const headline = isEn ? "Giving AI emotions" : "AIに感情を持たせる";

// The field, stated as something being built rather than merely named.
const subtitleLead = isEn
  ? "We are building the field that designs and evaluates it:"
  : "その設計と評価を担う研究領域、";
const subtitleTerm = "Computational Affective Intelligence";
const subtitleTail = isEn ? "" : "を私たちは作る";

const ctaPrimary = isEn ? "What is Affectosphere" : "Affectosphereとは";
const ctaSecondary = isEn ? "What is CAI" : "CAIとは";
---

<section
  class="relative flex min-h-[calc(100vh-8.3rem)] flex-col justify-center overflow-hidden bg-ivory"
  aria-labelledby="hero-heading"
>
  <!-- Background: the moving town. -->
  <TownScene />

  <!-- Instrument panels: what the scene is tracking, stated as numbers. They
       belong to the background, so they sit under the ivory wash with the
       town rather than over it. -->
  <TownPanels locale={locale} />

  <!-- Ivory wash: holds the headline at AA contrast over any frame of the scene. -->
  <div
    class="pointer-events-none absolute inset-0 z-[1]"
    aria-hidden="true"
    style="background:
      radial-gradient(ellipse 56% 40% at 50% 36%, rgba(250,250,247,0.86), rgba(250,250,247,0.34) 66%, rgba(250,250,247,0) 100%),
      linear-gradient(to bottom, rgba(250,250,247,0.55), rgba(250,250,247,0.05) 45%, rgba(250,250,247,0.18));"
  >
  </div>

  <!-- Foreground content. From xl up it keeps clear of the corner panels,
       so a short viewport cannot bring the two together. -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-content -translate-y-11 flex-col items-center py-24
           text-center page-x xl:px-[18.5rem]"
  >
    <h1
      id="hero-heading"
      class="reveal w-full font-display font-semibold tracking-tight text-[#0D0D0D]"
      style="font-size: clamp(1.7rem, 3.8vw, 3.3rem); line-height: 1.2; overflow-wrap: anywhere;"
    >
      <span class="mb-4 block text-[#333B45]" style="font-size: 0.56em; letter-spacing: 0.02em;">{headlineEra}</span>
      <span class="block">{headline}</span>
    </h1>

    <p
      class="reveal mt-10 w-full max-w-[58rem] font-display text-[#1A1A1A]"
      style="font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.72; overflow-wrap: anywhere;"
    >
      {subtitleLead}{isEn ? " " : ""}
      <span class="whitespace-nowrap font-semibold text-[#6B4E1C]">{subtitleTerm}</span>{subtitleTail}
    </p>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-4">
      <a href={`${prefix}/affectosphere/`} class="btn-solid-ink">
        {ctaPrimary}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a href={`${prefix}/cai/`} class="btn-solid-ink">
        {ctaSecondary}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Closing band: the same soft black as the navigation, marking where
       the moving scene ends and the page proper begins. -->
  <div class="absolute inset-x-0 bottom-0 z-20 h-10 bg-softink" aria-hidden="true"></div>
</section>
