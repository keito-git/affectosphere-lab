---
// The research map: the six stages of Computational Affective Intelligence,
// and how far each one has actually been filled in. Every dot is one
// publication from publications.ts — nothing is padded.
import { caiStages, stageStats, unmappedCount, tier, domainStage } from "../data/research-map";
import { researchDomains as domainsJa } from "../data/research-domains";
import { researchDomains as domainsEn } from "../data/research-domains.en";

interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const isEn = locale === "en";

const domains = isEn ? domainsEn : domainsJa;
const stats = stageStats();
const caiTotal = caiStages.reduce((n, s) => n + stats[s.id].total, 0);
const beyond = stats.beyond;
const total = caiTotal + beyond.total;
const unmapped = unmappedCount();
const domainPrefix = isEn ? "/en" : "";

/** Domains that mainly serve a given stage, for the cross-links under it. */
function domainsFor(stageId: string) {
  return domains.filter((d) => domainStage[d.slug] === stageId);
}

const dotClass = (pub: Parameters<typeof tier>[0]) => {
  const t = tier(pub);
  if (t === "international") return "bg-amber";
  if (t === "domestic") return "bg-[#7C8798]";
  return "border border-[#7C8798]";
};
---

<section
  id="research-map"
  class="surface-ink relative overflow-hidden scroll-mt-24"
  aria-labelledby="research-map-heading"
>
  <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-content page-x py-20 md:py-28">
    <header class="reveal max-w-prose">
      <p class="eyebrow">
        Research map<span class="mx-2 text-[#4a5464]">/</span>{caiTotal}
        {isEn ? "of" : "/"} {total} {isEn ? "publications" : "件の業績"}
      </p>
      <h2
        id="research-map-heading"
        class="mt-4 font-display text-3xl font-medium tracking-tight text-[#F4F2ED] md:text-4xl"
      >
        {isEn ? "Where we stand on the CAI stack" : "CAI の地図の、どこを埋めたか"}
      </h2>
      <p class="mt-5 font-display text-base leading-relaxed text-[#CFCBC2] md:text-lg">
        {
          isEn
            ? "Computational Affective Intelligence runs through six stages: an affective system reads emotion, holds it, reasons from it, gives it form, meets a person through it, and is finally placed in society. Each dot below is one publication, at the stage it contributes to most."
            : "Computational Affective Intelligence は六つの段でできている。感情を読み取り、保持し、それを前提に考え、形にし、人と向き合い、社会に据え直す。下のドットひとつが業績ひとつ、最も寄与する段に置いた。"
        }
      </p>
    </header>

    <!-- Legend -->
    <ul class="reveal mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-label text-[0.7rem] uppercase tracking-[0.14em] text-[#9AA4B4]">
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber" aria-hidden="true"></span>
        {isEn ? "International journal / conference" : "国際誌・国際会議"}
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-[#7C8798]" aria-hidden="true"></span>
        {isEn ? "Domestic venue / report" : "国内誌・国内会議・研究報告"}
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full border border-[#7C8798]" aria-hidden="true"></span>
        {isEn ? "Preprint" : "プレプリント"}
      </li>
    </ul>

    <!-- The stack -->
    <ol class="mt-12 border-t border-[#2B3341]">
      {
        caiStages.map((stage, i) => {
          const s = stats[stage.id];
          const related = domainsFor(stage.id);
          return (
            <li class="reveal border-b border-[#2B3341] py-7">
              <div class="grid gap-4 md:grid-cols-[3rem_16rem_1fr_3rem] md:items-baseline md:gap-6">
                <p class="font-label text-[0.8rem] tracking-[0.14em] text-[#4a5464]">
                  {String(i + 1).padStart(2, "0")}
                </p>

                <div>
                  <h3 class="font-label text-[0.9rem] uppercase tracking-[0.18em] text-amber">
                    {stage.label}
                  </h3>
                  {!isEn && (
                    <p class="mt-1 font-display text-lg text-[#E9E6DF]">{stage.labelJa}</p>
                  )}
                </div>

                <div>
                  <div class="flex flex-wrap items-center gap-[0.3rem]">
                    {s.pubs.map((pub) => (
                      <span
                        class={`inline-block h-2.5 w-2.5 rounded-full ${dotClass(pub)}`}
                        title={`${pub.title} (${pub.venue}, ${pub.year})`}
                      />
                    ))}
                  </div>
                  <p class="mt-3 font-display text-sm leading-relaxed text-[#9AA4B4]">
                    {isEn ? stage.noteEn : stage.note}
                  </p>
                  {related.length > 0 && (
                    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                      {related.map((d) => (
                        <a
                          href={`${domainPrefix}/research/${d.slug}/`}
                          class="font-display text-sm text-[#8C96A6] underline-offset-4 hover:text-amber hover:underline"
                        >
                          {d.title}
                        </a>
                      ))}
                    </p>
                  )}
                </div>

                <p class="font-label text-[0.8rem] tracking-[0.12em] text-[#6E7889] md:text-right">
                  {s.total}
                </p>
              </div>
            </li>
          );
        })
      }
    </ol>

    <!-- AI research outside affective AI: shown, but kept off the stack. -->
    <div class="reveal mt-10">
      <div class="grid gap-3 md:grid-cols-[3rem_16rem_1fr_3rem] md:items-baseline md:gap-6">
        <p class="font-label text-[0.8rem] tracking-[0.14em] text-[#3d4653]">&mdash;</p>
        <div>
          <h3 class="font-label text-[0.9rem] uppercase tracking-[0.18em] text-[#6E7889]">
            Beyond affect
          </h3>
          {!isEn && <p class="mt-1 font-display text-lg text-[#8C96A6]">感情AIの外側</p>}
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-[0.3rem] opacity-60">
            {beyond.pubs.map((pub) => (
              <span
                class={`inline-block h-2.5 w-2.5 rounded-full ${dotClass(pub)}`}
                title={`${pub.title} (${pub.venue}, ${pub.year})`}
              />
            ))}
          </div>
          <p class="mt-3 max-w-prose font-display text-sm leading-relaxed text-[#6E7889]">
            {
              isEn
                ? "AI research outside affective computing — scientific naming, conflict-structure corpora, model merging. Counted here rather than on the stack."
                : "感情AI以外のAI研究——学名の語源分析、紛争構造コーパス、モデルマージなど。スタックとは分けて数えている。"
            }
          </p>
        </div>
        <p class="font-label text-[0.8rem] tracking-[0.12em] text-[#3d4653] md:text-right">
          {beyond.total}
        </p>
      </div>
    </div>

    <!-- How the map is built, stated so the numbers can be checked. -->
    <p class="reveal mt-12 max-w-prose font-display text-sm leading-relaxed text-[#8C96A6]">
      {
        isEn
          ? `Every publication on this site was read and placed at the single stage it contributes to most; work spanning several stages is counted once. ${caiTotal} sit on the CAI stack and ${beyond.total} outside it${unmapped > 0 ? `, with ${unmapped} not yet placed` : ""}.`
          : `本サイトに掲載している業績を一件ずつ読み、最も寄与する段ひとつに置いた。複数の段にまたがる研究も一度だけ数えている。CAI のスタック上に ${caiTotal} 件、その外側に ${beyond.total} 件${unmapped > 0 ? `（未割り当て ${unmapped} 件）` : ""}。`
      }
      <a
        href={`${domainPrefix}/publications/`}
        class="ml-2 text-amber underline underline-offset-4 hover:text-[#d3a95f]"
      >
        {isEn ? "Publications" : "Publications を見る"} &rarr;
      </a>
    </p>
  </div>
</section>
