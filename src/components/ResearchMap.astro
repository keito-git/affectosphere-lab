---
// The research map: how far each of the ten CAI domains has actually been
// filled in. Every dot is one publication from publications.ts — nothing is
// padded, and the two domains with no publications yet are shown empty.
import { layers, domainStats, unmappedCount, tier } from "../data/research-map";
import { researchDomains as domainsJa } from "../data/research-domains";
import { researchDomains as domainsEn } from "../data/research-domains.en";

interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const isEn = locale === "en";

const titles = new Map(
  (isEn ? domainsEn : domainsJa).map((d) => [d.slug, d.title]),
);
const stats = domainStats();
const mapped = Object.values(stats).reduce((n, s) => n + s.total, 0);
const beyond = stats["other-ai-research"];
const caiStats = Object.values(stats).filter((s) => s.layer !== "beyond");
const caiTotal = caiStats.reduce((n, s) => n + s.total, 0);
const unmapped = unmappedCount();
const filled = caiStats.filter((s) => s.total > 0).length;
const caiDomains = caiStats.length;
const domainHref = (slug: string) => `${isEn ? "/en" : ""}/research/${slug}/`;
---

<section id="research-map" class="surface-ink relative overflow-hidden scroll-mt-24" aria-labelledby="research-map-heading">
  <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-content page-x py-20 md:py-28">
    <header class="reveal max-w-prose">
      <p class="eyebrow">
        Research map<span class="mx-2 text-[#4a5464]">/</span>{caiTotal}
        {isEn ? "of" : "/"} {mapped} {isEn ? "publications" : "件の業績"}
      </p>
      <h2
        id="research-map-heading"
        class="mt-4 font-display text-3xl font-medium tracking-tight text-[#F4F2ED] md:text-4xl"
      >
        {isEn ? "Where we are on the map of CAI" : "CAI の地図の、どこを埋めたか"}
      </h2>
      <p class="mt-5 font-display text-base leading-relaxed text-[#CFCBC2] md:text-lg">
        {
          isEn
            ? `Nine domains make up Computational Affective Intelligence. Each dot below is one publication, placed in the domain it contributes to most. Two domains are still empty — that is where the work goes next.`
            : `Computational Affective Intelligence は、九つの領域でできている。下のドットひとつが業績ひとつ、最も寄与する領域に置いた。二つの領域はまだ空いている。次に向かうのはそこだ。`
        }
      </p>
    </header>

    <!-- Legend -->
    <ul class="reveal mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-label text-[0.7rem] uppercase tracking-[0.14em] text-[#9AA4B4]">
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber" aria-hidden="true"></span>
        {isEn ? "International journal / conference" : "国際誌・国際会議"}
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-[#7C8798]" aria-hidden="true"></span>
        {isEn ? "Domestic venue / report" : "国内誌・国内会議・研究報告"}
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full border border-[#7C8798]" aria-hidden="true"></span>
        {isEn ? "Preprint" : "プレプリント"}
      </li>
    </ul>

    <!-- Layers -->
    <div class="mt-14 space-y-14">
      {
        layers.map((layer) => {
          const rows = caiStats.filter((s) => s.layer === layer.id);
          const layerTotal = rows.reduce((n, s) => n + s.total, 0);
          return (
            <div class="reveal">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-[#2B3341] pb-3">
                <h3 class="font-label text-[0.78rem] uppercase tracking-[0.2em] text-amber">
                  {isEn ? layer.labelEn : layer.label}
                </h3>
                <p class="font-display text-sm text-[#9AA4B4]">
                  {isEn ? layer.noteEn : layer.note}
                </p>
                <p class="ml-auto font-label text-[0.72rem] tracking-[0.12em] text-[#6E7889]">
                  {layerTotal}
                </p>
              </div>

              <ul class="mt-6 space-y-5">
                {rows.map((s) => (
                  <li class="grid gap-2 md:grid-cols-[15rem_1fr_3rem] md:items-center md:gap-6">
                    <a
                      href={domainHref(s.slug)}
                      class="font-display text-base text-[#E9E6DF] underline-offset-4 hover:text-amber hover:underline"
                    >
                      {titles.get(s.slug) ?? s.slug}
                    </a>

                    {s.total > 0 ? (
                      <div class="flex flex-wrap items-center gap-[0.3rem]">
                        {s.pubs.map((pub) => {
                          const t = tier(pub);
                          const cls =
                            t === "international"
                              ? "bg-amber"
                              : t === "domestic"
                                ? "bg-[#7C8798]"
                                : "border border-[#7C8798]";
                          return (
                            <span
                              class={`inline-block h-2.5 w-2.5 rounded-full ${cls}`}
                              title={`${pub.title} (${pub.venue}, ${pub.year})`}
                            />
                          );
                        })}
                      </div>
                    ) : (
                      <div class="flex items-center">
                        <span class="inline-flex items-center gap-2 border border-dashed border-[#4a5464] px-3 py-1 font-label text-[0.68rem] uppercase tracking-[0.16em] text-[#8C96A6]">
                          Frontier
                          <span class="font-display text-[0.8rem] normal-case tracking-normal">
                            {isEn ? "opening up" : "立ち上がり中"}
                          </span>
                        </span>
                      </div>
                    )}

                    <p class="font-label text-[0.72rem] tracking-[0.12em] text-[#6E7889] md:text-right">
                      {s.total}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>


    <!-- Work that is AI research but not affective AI: kept off the CAI map so
         the map above reads as coverage of CAI, but still shown in full. -->
    <div class="reveal mt-14 border-t border-[#2B3341] pt-8">
      <div class="grid gap-3 md:grid-cols-[15rem_1fr_3rem] md:items-center md:gap-6">
        <div>
          <p class="font-label text-[0.72rem] uppercase tracking-[0.2em] text-[#6E7889]">
            Beyond affect
          </p>
          <a
            href={domainHref(beyond.slug)}
            class="mt-1 block font-display text-base text-[#B8B4AC] underline-offset-4 hover:text-amber hover:underline"
          >
            {titles.get(beyond.slug) ?? beyond.slug}
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-[0.3rem] opacity-70">
          {beyond.pubs.map((pub) => {
            const t = tier(pub);
            const cls =
              t === "international"
                ? "bg-amber"
                : t === "domestic"
                  ? "bg-[#7C8798]"
                  : "border border-[#7C8798]";
            return (
              <span
                class={`inline-block h-2.5 w-2.5 rounded-full ${cls}`}
                title={`${pub.title} (${pub.venue}, ${pub.year})`}
              />
            );
          })}
        </div>
        <p class="font-label text-[0.72rem] tracking-[0.12em] text-[#6E7889] md:text-right">
          {beyond.total}
        </p>
      </div>
      <p class="mt-4 max-w-prose font-display text-sm leading-relaxed text-[#6E7889]">
        {
          isEn
            ? "AI research outside affective computing — scientific naming, conflict-structure corpora, model merging and related work. Counted here rather than on the CAI map."
            : "感情AI以外のAI研究——学名の語源分析、紛争構造コーパス、モデルマージなど。CAI の地図とは分けて数えている。"
        }
      </p>
    </div>

    <!-- How the map is built. Stated plainly so the numbers can be checked. -->
    <p class="reveal mt-14 max-w-prose font-display text-sm leading-relaxed text-[#8C96A6]">
      {
        isEn
          ? `Every publication listed on this site was read and placed in the single domain it contributes to most; papers spanning several domains are counted once. ${filled} of the ${caiDomains} CAI domains currently hold work, alongside ${beyond.total} publications outside affective AI${unmapped > 0 ? `, with ${unmapped} not yet placed` : ""}. The full list is on the publications page.`
          : `本サイトに掲載している業績を一件ずつ読み、最も寄与する領域ひとつに割り当てた。複数領域にまたがる研究も一度だけ数えている。現在、CAI の ${caiDomains} 領域のうち ${filled} 領域に業績があり、これとは別に感情AI以外の研究が ${beyond.total} 件ある${unmapped > 0 ? `（未割り当て ${unmapped} 件）` : ""}。全件は Publications ページに掲載している。`
      }
      <a href={`${isEn ? "/en" : ""}/publications/`} class="ml-2 text-amber underline underline-offset-4 hover:text-[#d3a95f]">
        {isEn ? "Publications" : "Publications を見る"} &rarr;
      </a>
    </p>
  </div>
</section>
