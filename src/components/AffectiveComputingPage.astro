<div class="h-section-sm" aria-hidden="true"></div>

<script>
  // The console: picking a moment on the timeline rewrites the readout. Only
  // numbers move; every word on the panel is rendered by the page.
  const root = document.querySelector<HTMLElement>("[data-ac-console]");
  if (root && root.dataset.payload) {
    type Frame = {
      t: string; p: number[]; v: number; a: number; c: number;
      top: number; x: number; vy: number; ay: number;
    };
    const data = JSON.parse(root.dataset.payload) as {
      barMax: number;
      emo: { name: string; hex: string }[];
      frames: Frame[];
    };

    const bars = Array.from(root.querySelectorAll<HTMLElement>("[data-bar]"));
    const vals = Array.from(root.querySelectorAll<HTMLElement>("[data-val]"));
    const ticks = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-frame]"));
    const slot = (n: string) => root.querySelector<HTMLElement>(`[data-f="${n}"]`);
    const playhead = root.querySelector<SVGLineElement>('[data-f="playhead"]');

    function show(i: number) {
      const f = data.frames[i];
      if (!f) return;
      bars.forEach((b, k) => {
        b.style.width = Math.max(1, (f.p[k] / data.barMax) * 100) + "%";
      });
      vals.forEach((v, k) => { v.textContent = f.p[k].toFixed(2); });

      const clock = slot("clock");
      if (clock) clock.textContent = f.t;
      const name = slot("top-name");
      if (name) name.textContent = data.emo[f.top].name;
      const dot = slot("top-dot");
      if (dot) dot.style.backgroundColor = data.emo[f.top].hex;
      const topv = slot("top-value");
      if (topv) topv.textContent = f.p[f.top].toFixed(2);

      const v = slot("v"); if (v) v.textContent = f.v.toFixed(2);
      const a = slot("a"); if (a) a.textContent = f.a.toFixed(2);
      const c = slot("c"); if (c) c.textContent = f.c.toFixed(2);

      if (playhead) {
        playhead.setAttribute("x1", String(f.x));
        playhead.setAttribute("x2", String(f.x));
      }
      ticks.forEach((t, k) => t.setAttribute("aria-pressed", k === i ? "true" : "false"));
    }

    ticks.forEach((t, i) => {
      t.addEventListener("click", () => show(i));
      t.addEventListener("mouseenter", () => show(i));
    });
    show(ticks.findIndex((t) => t.getAttribute("aria-pressed") === "true") || 0);
  }
</script>
