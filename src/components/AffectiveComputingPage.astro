          <line x1={CX0} y1={(V_TOP + V_BOT) / 2} x2={CX1} y2={(V_TOP + V_BOT) / 2} stroke="#F4F2ED" stroke-width="1" opacity="0.22" vector-effect="non-scaling-stroke" />
          <line x1={CX0} y1={V_BOT} x2={CX1} y2={V_BOT} stroke="#F4F2ED" stroke-width="1" opacity="0.08" vector-effect="non-scaling-stroke" />
          <polyline points={vLine} stroke="#C4974A" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />

          <!-- Arousal band -->
          <line x1={CX0} y1={A_TOP} x2={CX1} y2={A_TOP} stroke="#F4F2ED" stroke-width="1" opacity="0.08" vector-effect="non-scaling-stroke" />
          <line x1={CX0} y1={A_BOT} x2={CX1} y2={A_BOT} stroke="#F4F2ED" stroke-width="1" opacity="0.08" vector-effect="non-scaling-stroke" />
          <polyline points={aLine} stroke="#6FA0C4" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />

          <!-- Playhead -->
          <line data-f="playhead" x1={cx(SELECTED)} y1="10" x2={cx(SELECTED)} y2="220"
                stroke="#C4974A" stroke-width="1" stroke-dasharray="4 4" opacity="0.8" vector-effect="non-scaling-stroke" />
        </svg>

        <!-- Band scales and legend, outside the plot so nothing overlaps -->
        <div class="mt-3 flex flex-wrap items-center gap-x-8 gap-y-2 font-label text-[0.7rem] text-[#9aa4b4]">
          <span class="flex items-center gap-2">
            <span class="inline-block h-[3px] w-6 bg-amber" aria-hidden="true"></span>
            {isEn ? "valence" : "快 / 不快"} <span class="text-[#6c7686]">+0.5 &hellip; &minus;0.5</span>
          </span>
          <span class="flex items-center gap-2">
            <span class="inline-block h-[3px] w-6 bg-[#6FA0C4]" aria-hidden="true"></span>
            {isEn ? "arousal" : "覚醒度"} <span class="text-[#6c7686]">0.75 &hellip; 0.42</span>
          </span>
        </div>

        <!-- The timeline itself: one button per frame -->
        <div class="mt-5" style="padding-left: 7.4%; padding-right: 3.7%;">
          <div class="flex items-start justify-between">
            {
              frames.map((f, i) => (
                <button
                  type="button"
                  data-frame={i}
                  aria-pressed={i === SELECTED ? "true" : "false"}
                  class="dash-tick group flex flex-col items-center gap-2 px-1 py-1 font-label text-[0.66rem] text-[#8d96a5]"
                >
                  <span class="dash-tick-dot inline-block h-2.5 w-2.5 rounded-full border border-[#6c7686]"></span>
                  <span class="dash-tick-label tabular-nums">{f.t}</span>
                </button>
              ))
            }
          </div>
        </div>

        <p class="mt-6 max-w-[72rem] font-display text-base leading-relaxed text-[#9aa4b4]">
          {
            isEn
              ? "A single frame says little. The shape over two and a half minutes is what a system acts on: something happened around a minute in, and it had passed by the end."
              : "1フレームだけでは、ほとんど何も言えない。システムが拠りどころにするのは2分半の形のほうで、1分あたりで何かが起き、終わりまでには収まっている。"
          }
        </p>
      </div>
    </div>
  </div>
</section>

