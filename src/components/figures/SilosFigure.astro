---
// Concept figure for CAIの倫理と哲学.
//
// What the text says: affective AI is six layers stacked into one socio-technical
// system, each layer deepening on its own — and the problem lives in the gaps
// between them, where responsibility falls through. So the figure draws the
// stack and makes the gaps the thing you notice.
interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const isEn = locale === "en";

const LAYERS = isEn
  ? ["Ethics & evaluation", "Social application", "Interface & dialogue", "Model", "Data & annotation", "Theory of emotion"]
  : ["倫理・評価", "社会応用", "対話インタフェース", "モデル", "データ・アノテーション", "感情の理論"];

const W = 300;
const X = 168;
const H = 40;
const GAP = 16;
const TOP = 54;
const y = (i: number) => TOP + i * (H + GAP);
---

<svg viewBox="0 0 640 420" class="fig h-auto w-full" role="img" aria-labelledby="silos-title">
  <title id="silos-title">
    {isEn
      ? "Six layers of affective AI, stacked but disconnected at their boundaries"
      : "積み重なってはいるが、境界でつながっていないAffective AIの6つの層"}
  </title>

  <text x="20" y="26" class="fig-head">
    {isEn ? "Each layer deepens on its own" : "層はそれぞれ深まる"}
  </text>
  <text x="620" y="26" text-anchor="end" class="fig-head fig-accent">
    {isEn ? "and the gaps are where it breaks" : "壊れるのは、あいだ"}
  </text>

  {
    LAYERS.map((name, i) => (
      <g>
        <rect x={X} y={y(i)} width={W} height={H} rx="2" fill="#F4F0E8" stroke="#E2DDD6" />
        <text x={X + W / 2} y={y(i) + H / 2 + 5} text-anchor="middle" class="fig-label">
          {name}
        </text>
        {/* Depth of each layer, drawn as its own inward arrow. */}
        <line x1={X - 34} y1={y(i) + H / 2} x2={X - 10} y2={y(i) + H / 2} stroke="#6B7280" stroke-width="1" opacity="0.5" />
      </g>
    ))
  }

  {/* The gaps: what the text is actually about. */}
  {
    LAYERS.slice(0, -1).map((_, i) => {
      const gy = y(i) + H + GAP / 2;
      return (
        <g>
          <line x1={X} y1={gy} x2={X + W} y2={gy} stroke="#C4974A" stroke-width="1" stroke-dasharray="4 5" />
          <circle cx={X + W + 22} cy={gy} r="3" fill="#7B5E28" />
        </g>
      );
    })
  }

  <path
    d={`M ${X + W + 50} ${y(0) + H + GAP / 2} L ${X + W + 50} ${y(4) + H + GAP / 2}`}
    stroke="#7B5E28"
    stroke-width="0.8"
    stroke-opacity="0.45"
    fill="none"
  />
  <text x={X + W + 60} y={y(2) + H / 2 - 2} class="fig-side fig-accent">
    {isEn ? "Responsibility" : "責任が"}
  </text>
  <text x={X + W + 60} y={y(2) + H / 2 + 14} class="fig-side fig-accent">
    {isEn ? "falls through here" : "落ちる場所"}
  </text>

  <text x="20" y={y(2) + H / 2 - 2} class="fig-side">
    {isEn ? "Psychology, ML," : "心理学・機械学習・"}
  </text>
  <text x="20" y={y(2) + H / 2 + 14} class="fig-side">
    {isEn ? "HCI, ethics —" : "HCI・倫理学が"}
  </text>
  <text x="20" y={y(2) + H / 2 + 30} class="fig-side">
    {isEn ? "each on its own" : "別々に深める"}
  </text>
</svg>

