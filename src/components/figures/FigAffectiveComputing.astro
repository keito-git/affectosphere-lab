---
// Affective computing: the subject of emotion is the person. What they say,
// their face and their physiological signals are taken and handed to the AI
// (understanding); the AI then acts back on the person (intervention).
// Drawn by the design team for the home page; every label comes from the page
// so the figure works in both languages.
interface Props {
  flow: string;
  back: string;
  left: string;
  right: string;
  m1: string;
  m2: string;
  m3: string;
}
const { flow, back, left, right, m1, m2, m3 } = Astro.props;
---

<svg class="mt-6 w-full" role="img" viewBox="0 0 440 260" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Clip emotion curve to body interior -->
    <clipPath id="ac-body-clip">
      <path d="M 57 65 C 54 100 47 135 45 165 Q 68 173 91 165 C 89 135 82 100 79 65 Z"/>
    </clipPath>
    <!-- Main flow arrowhead (amber): modality bundle → AI understanding -->
    <marker id="ac-arw" viewBox="0 0 10 10" refX="9" refY="5"
            markerWidth="6" markerHeight="6" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#C4974A"/>
    </marker>
    <!-- Intervention arrowhead (dark): AI → human -->
    <marker id="ac-arw-back" viewBox="0 0 10 10" refX="9" refY="5"
            markerWidth="6" markerHeight="6" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#1A1A1A" opacity="0.55"/>
    </marker>
  </defs>

  <!-- ── Human (peg doll, front-facing) ──────────────────────────────── -->
  <!-- Head -->
  <circle cx="68" cy="48" r="16" stroke="#1A1A1A" stroke-width="1.5" fill="#FAFAF7"/>
  <!-- Dot eyes -->
  <circle cx="63" cy="46" r="2.2" fill="#1A1A1A"/>
  <circle cx="73" cy="46" r="2.2" fill="#1A1A1A"/>
  <!-- Smile -->
  <path d="M 64 54 Q 68 59 72 54"
        stroke="#1A1A1A" stroke-width="1.2" stroke-linecap="round"/>
  <!-- Body: tapered dress / peg shape (top narrow, hem flares) -->
  <path d="M 57 65 C 54 100 47 135 45 165 Q 68 173 91 165 C 89 135 82 100 79 65 Z"
        stroke="#1A1A1A" stroke-width="1.5" fill="#FAFAF7"/>
  <!-- Arm stubs -->
  <line x1="57" y1="83" x2="42" y2="98"
        stroke="#1A1A1A" stroke-width="2" stroke-linecap="round"/>
  <line x1="79" y1="83" x2="94" y2="98"
        stroke="#1A1A1A" stroke-width="2" stroke-linecap="round"/>
  <!-- Emotion distribution (amber) clipped to body interior – larger than original -->
  <!-- Outer g holds clip-path in root coords; inner g holds the transform -->
  <g clip-path="url(#ac-body-clip)">
    <g transform="translate(46,82) scale(0.65)">
      <line x1="-4" y1="44" x2="70" y2="44"
            stroke="#1A1A1A" stroke-width="1" opacity="0.22"/>
      <path d="M 0 44 C 9 44 11 3 22 3 C 32 3 33 25 43 25
               C 51 25 54 44 66 44 L 66 44 L 0 44 Z"
            fill="#C4974A" opacity="0.25"/>
      <path d="M 0 44 C 9 44 11 3 22 3 C 32 3 33 25 43 25 C 51 25 54 44 66 44"
            stroke="#C4974A" stroke-width="2.5"/>
    </g>
  </g>

  <!-- ── Modality Icons ────────────────────────────────────────────────
       Each label sits centred UNDER its icon, clear of the connector
       curves, which leave from the icon's right edge well above it.
  ──────────────────────────────────────────────────────────────────── -->

  <!-- M1: Speech bubble (spoken content) – icon top y=70, center y=81 -->
  <g transform="translate(131,44)">
    <rect x="0" y="0" width="36" height="22" rx="5"
          stroke="#1A1A1A" stroke-width="1.2" fill="#E2DDD6"/>
    <!-- Tail pointing toward human -->
    <path d="M 6 22 L 1 29 L 15 22"
          stroke="#1A1A1A" stroke-width="1.2" fill="#E2DDD6"/>
    <!-- Voice / text lines -->
    <line x1="6" y1="7"  x2="30" y2="7"  stroke="#1A1A1A" stroke-width="1.2" opacity="0.55" stroke-linecap="round"/>
    <line x1="6" y1="12" x2="26" y2="12" stroke="#1A1A1A" stroke-width="1.2" opacity="0.55" stroke-linecap="round"/>
    <line x1="6" y1="17" x2="21" y2="17" stroke="#1A1A1A" stroke-width="1.2" opacity="0.55" stroke-linecap="round"/>
  </g>
  <!-- M1 label: centred under the icon -->
  <text x="149" y="84" font-family="JetBrains Mono, monospace" font-size="9"
        text-anchor="middle" fill="#6B7280">{m1}</text>

  <!-- M2: Face photo frame (facial image) – icon top y=110, center y=126 -->
  <g transform="translate(133,94)">
    <rect x="0" y="0" width="32" height="32" rx="3"
          stroke="#1A1A1A" stroke-width="1.2" fill="#E2DDD6"/>
    <rect x="3" y="3" width="26" height="26" rx="2"
          stroke="#1A1A1A" stroke-width="0.8" fill="#FAFAF7" opacity="0.9"/>
    <!-- Cute face inside the frame -->
    <circle cx="16" cy="16" r="9" stroke="#1A1A1A" stroke-width="1" fill="#FAFAF7"/>
    <circle cx="12.5" cy="14" r="1.5" fill="#1A1A1A"/>
    <circle cx="19.5" cy="14" r="1.5" fill="#1A1A1A"/>
    <path d="M 12 20 Q 16 24 20 20"
          stroke="#1A1A1A" stroke-width="1" stroke-linecap="round"/>
  </g>
  <!-- M2 label: centred under the icon -->
  <text x="149" y="137" font-family="JetBrains Mono, monospace" font-size="9"
        text-anchor="middle" fill="#6B7280">{m2}</text>

  <!-- M3: ECG biosignal – icon top y=158, center y=169 -->
  <g transform="translate(130,146)">
    <rect x="0" y="0" width="38" height="22" rx="3"
          stroke="#1A1A1A" stroke-width="1.2" fill="#E2DDD6"/>
    <!-- ECG waveform (amber) -->
    <polyline points="3,11 8,11 11,4 14,18 17,4 20,11 35,11"
              stroke="#C4974A" stroke-width="1.6"
              fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  <!-- M3 label: centred under the icon -->
  <text x="149" y="179" font-family="JetBrains Mono, monospace" font-size="9"
        text-anchor="middle" fill="#6B7280">{m3}</text>

  <!-- ── Convergence lines: icon right edges → gather point (245,125) ──
       They leave above each label, so no line ever crosses text. -->
  <path d="M 169 55 C 202 55 228 98 245 124"
        stroke="#1A1A1A" stroke-width="1.2" opacity="0.45" stroke-linecap="round"/>
  <path d="M 167 110 C 198 110 226 120 245 125"
        stroke="#1A1A1A" stroke-width="1.2" opacity="0.45" stroke-linecap="round"/>
  <path d="M 170 157 C 202 157 228 148 245 126"
        stroke="#1A1A1A" stroke-width="1.2" opacity="0.45" stroke-linecap="round"/>

  <!-- Gather / bundle junction (amber dot) -->
  <circle cx="245" cy="125" r="4" fill="#C4974A"/>

  <!-- ── Main flow arrow: bundle → AI (understanding) ─────────────── -->
  <line x1="249" y1="125" x2="318" y2="125"
        stroke="#C4974A" stroke-width="2" stroke-linecap="round"
        marker-end="url(#ac-arw)"/>

  <!-- ── AI Robot (cute, neutral face) ────────────────────────────── -->
  <!-- Antenna -->
  <line x1="360" y1="65" x2="360" y2="50"
        stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="360" cy="46" r="5" stroke="#1A1A1A" stroke-width="1.5" fill="#FAFAF7"/>
  <!-- Body -->
  <rect x="320" y="67" width="80" height="98" rx="10"
        stroke="#1A1A1A" stroke-width="1.5" fill="#FAFAF7"/>
  <!-- Face panel -->
  <rect x="332" y="80" width="56" height="50" rx="4"
        stroke="#1A1A1A" stroke-width="1" fill="#E2DDD6"/>
  <!-- Eyes (circular indicator, neutral – AI is not emotional here) -->
  <circle cx="349" cy="98" r="5.5" stroke="#1A1A1A" stroke-width="1" fill="#FAFAF7"/>
  <circle cx="349" cy="98" r="2"   fill="#1A1A1A"/>
  <circle cx="371" cy="98" r="5.5" stroke="#1A1A1A" stroke-width="1" fill="#FAFAF7"/>
  <circle cx="371" cy="98" r="2"   fill="#1A1A1A"/>
  <!-- Mouth: neutral flat line -->
  <line x1="347" y1="118" x2="373" y2="118"
        stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>
  <!-- Input indicator lights (three amber dots on left body edge = 3 modalities received) -->
  <circle cx="328" cy="95"  r="2.5" fill="#C4974A" opacity="0.65"/>
  <circle cx="328" cy="107" r="2.5" fill="#C4974A" opacity="0.40"/>
  <circle cx="328" cy="119" r="2.5" fill="#C4974A" opacity="0.20"/>
  <!-- Feet -->
  <rect x="330" y="165" width="22" height="10" rx="3"
        stroke="#1A1A1A" stroke-width="1" fill="#FAFAF7"/>
  <rect x="368" y="165" width="22" height="10" rx="3"
        stroke="#1A1A1A" stroke-width="1" fill="#FAFAF7"/>

  <!-- ── Return arrow: AI → human (intervention) ───────────────────── -->
  <path d="M 320 162 C 252 215 168 217 91 190"
        stroke="#1A1A1A" stroke-width="1.6" stroke-linecap="round"
        marker-end="url(#ac-arw-back)"/>

  <!-- ── Labels ─────────────────────────────────────────────────────── -->
  <g font-family="JetBrains Mono, monospace" letter-spacing="0.3">
    <!-- Flow annotation: above the main amber arrow -->
    <text x="284" y="113" font-size="10" text-anchor="middle" fill="#6B7280">{flow}</text>
    <!-- Intervention annotation: below the return curve -->
    <text x="207" y="234" font-size="10" text-anchor="middle" fill="#6B7280">{back}</text>
    <!-- Entity labels -->
    <text x="68"  y="213" font-size="10" text-anchor="middle" fill="#7B5E28">{left}</text>
    <text x="360" y="228" font-size="10" text-anchor="middle" fill="#6B7280">{right}</text>
  </g>
</svg>
