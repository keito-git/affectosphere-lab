---
// The services content now lives on the Contact page, which carries both the
// engagement menu and the general inquiry form. This stub keeps older links
// and bookmarks working instead of leaving them on a dead URL.
const target = "/contact/";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>お問い合わせページへ移動しました</title>
  </head>
  <body>
    <p><a href={target}>このページはお問い合わせページへ移動しました。</a></p>
  </body>
</html>
