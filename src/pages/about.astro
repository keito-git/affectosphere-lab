---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import Img from "../components/Img.astro";

// Education timeline (researchmap, 2026-05-30).  Newest at top.
const education = [
  {
    period: "2025/04 — present",
    degree: "博士後期課程",
    program: "大学院商学研究科 商学専攻",
    institution: "関西大学",
  },
  {
    period: "2023/04 — 2025/03",
    degree: "修士(データサイエンス)",
    program: "大学院データサイエンス研究科 博士前期課程",
    institution: "滋賀大学",
  },
  {
    period: "2020/04 — 2023/03",
    degree: "(中退・飛び級進学)",
    program: "地域共創学群 経営学専攻",
    institution: "札幌大学",
    note: "大学院への飛び級進学のため、3年次修了時点で中退。",
  },
];

// Current affiliations & research positions (researchmap).
const affiliations = [
  {
    period: "2025/04 — present",
    affiliation: "関西大学 大学院商学研究科 商学専攻",
    role: "博士後期課程",
  },
  {
    period: "2025/04 — present",
    affiliation: "滋賀大学 データサイエンス・AIイノベーション研究推進センター",
    role: "客員研究員",
  },
  {
    period: "2025/04 — present",
    affiliation: "日本セーフティソサイエティ研究センター",
    role: "研究員",
  },
  {
    period: "2025/12 — 2026/03",
    affiliation: "立命館大学 立命館グローバル・イノベーション研究機構",
    role: "客員研究員",
  },
  {
    period: "2025/04 — present",
    affiliation:
      "JST 次世代研究者挑戦的研究プログラム(SPRING)",
    role: "関西大学 SPRING スカラシップ研究学生",
  },
];

// External profile links.
const links = [
  { label: "researchmap", href: "https://researchmap.jp/keito_inoshita" },
  { label: "ORCID", href: "https://orcid.org/0009-0006-6854-7231" },
  { label: "X (Twitter)", href: "https://x.com/keito0data" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  },
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://lab.affectosphere.group/about/#person",
  name: "Keito Inoshita",
  alternateName: "井下 敬翔",
  url: "https://lab.affectosphere.group/about/",
  jobTitle: "計算的感情知能（Computational Affective Intelligence）研究者",
  description:
    "AI に感情知能を与える研究者。感情の読み取りから、保持・推論・生成・相互作用・社会への定着までを Computational Affective Intelligence というひと続きの体系として扱う。",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "関西大学 大学院商学研究科" },
    { "@type": "CollegeOrUniversity", name: "滋賀大学 データサイエンス・AIイノベーション研究推進センター" },
    { "@type": "Organization", name: "日本セーフティソサイエティ研究センター" },
  ],
  knowsAbout: [
    "Computational Affective Intelligence",
    "Affective Computing",
    "感情AI",
    "大規模言語モデル",
    "感情認識",
    "不確実性の定量化",
    "感情データ生成",
    "AI倫理",
  ],
  sameAs: [
    "https://researchmap.jp/keito_inoshita",
    "https://orcid.org/0009-0006-6854-7231",
    "https://x.com/keito0data",
    "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  ],
  worksFor: { "@id": "https://lab.affectosphere.group/#organization" },
};
---

<BaseLayout jsonLd={personLd}
  title="井下敬翔 — 計算的感情知能（CAI）研究者"
  description="井下敬翔。AIに感情知能を与える研究者。計算的感情知能（Computational Affective Intelligence）を軸に、感情の認識・表現・推論・生成から倫理まで。経歴・所属・研究業績。"
  fullBleed
>
  <PageHeader
    eyebrow="About"
    title="Keito Inoshita"
    subtitle="Computational Affective Intelligence researcher. Founder, Affectosphere Group."
  />

  <!-- Identity card: portrait placeholder + short bio side by side. -->
  <section
    class="mx-auto mt-section-sm grid max-w-content gap-10 page-x md:grid-cols-[20rem_1fr] md:gap-14"
    aria-labelledby="bio"
  >
    <div class="reveal">
      <div class="aspect-square w-full overflow-hidden border border-stone bg-cream">
        <Img src="/people/keito-inoshita.jpg" alt="Keito Inoshita" class="h-full w-full object-cover" />
      </div>
      <p class="mt-4 font-sans text-[0.75rem] uppercase tracking-[0.14em] text-slate font-medium">
        井下 敬翔 &middot; Keito Inoshita
      </p>
    </div>

    <div>
      <p class="font-sans text-base font-medium tracking-wide text-slate reveal">
        Bio
      </p>
      <p
        id="bio"
        class="reveal mt-3 font-display text-lg leading-relaxed text-charcoal md:text-xl"
        style="line-height: 1.85;"
      >
        AI に感情知能を与える研究をしている。
        感情の読み取りから、保持・推論・生成・相互作用・社会への定着までをひと続きの体系として扱い、
        これを Computational Affective Intelligence（CAI）と呼んでいる。
        関西大学大学院、滋賀大学 DS・AI研究推進センター、
        日本セーフティソサイエティ研究センターに所属し、
        多様な企業と連携しながら AI × 感情の研究開発を進めている。
        Affectosphereを立ち上げ、
        AIを用いた人間の感情の生成・認識・理解から、人間とのインタラクション、
        感情AIの倫理や哲学までを一貫して研究を行っている。
        最終的に目指すのは、人間を超える EQ を備えた AI の実現である。
      </p>

      <p class="font-sans text-base font-medium tracking-wide text-slate reveal mt-12">
        Research Statement
      </p>
      <div class="reveal mt-3 space-y-5 font-display text-base leading-relaxed text-charcoal md:text-lg" style="line-height: 1.85;">
        <p>
          研究の問いは一貫している ―
          <em class="italic">どうすれば、AI は人間の感情をその豊かさを損なわずに扱えるか</em>。
          感情は曖昧で多義的でありながら、社会のあらゆる場面で人の判断と関係に影響を与えている。
          そのあいまいさを切り捨てずに計算の対象とすることが、研究の出発点である。
        </p>
        <p>
          このために、AIを用いた人間の感情の <em class="italic">生成・認識・理解</em> から、
          <em class="italic">人間とのインタラクション</em>、そして
          <em class="italic">感情AIの倫理や哲学</em> までを一貫して研究している。
          認識は曖昧さを分布として推定する技術、生成と表出は人とAIが感情を介して対話する界面、
          理解は人がそもそも感情をどう経験しているかという問いの再考、
          そして倫理や哲学は感情AIの社会的位置づけを構造的に問い直す試みである。
        </p>
        <p>
          学術研究にとどまらず、多様な企業との連携を通じて、
          感情AIが実装され社会に届く現場の知見も研究の土台に取り込んでいる。
          目指すのは、人間を超える EQ を備えた AI の輪郭を、
          技術と人文、そして実装と理論の往復のなかで描き出していくことである。
        </p>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="education"
  >
    <h2
      id="education"
      class="reveal font-heading text-2xl font-medium tracking-tight text-charcoal md:text-3xl"
    >
      Education
    </h2>
    <ul class="mt-8 w-full">
      {
        education.map((row) => (
          <li class="reveal grid gap-2 border-b border-stone py-5 last:border-b-0 md:grid-cols-[12rem_1fr] md:gap-10">
            <span class="font-display text-sm italic text-slate">
              {row.period}
            </span>
            <div>
              <p class="font-display text-base text-charcoal md:text-lg">
                {row.degree} &middot; {row.program}
              </p>
              <p class="mt-1 font-display text-sm text-slate">{row.institution}</p>
              {row.note && (
                <p class="mt-1 font-display text-sm italic text-slate">{row.note}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Affiliations -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="affiliations"
  >
    <h2
      id="affiliations"
      class="reveal font-heading text-2xl font-medium tracking-tight text-charcoal md:text-3xl"
    >
      Affiliations
    </h2>
    <ul class="reveal mt-8 max-w-prose space-y-4 border-l border-stone pl-6 text-base text-charcoal">
      {
        affiliations.map((a) => (
          <li>
            <p class="font-display text-base text-charcoal md:text-lg">
              {a.affiliation}
            </p>
            <p class="mt-1 text-sm text-slate">
              {a.role}
              <span class="ml-3 font-display text-xs italic">{a.period}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Links + CV -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="links"
  >
    <h2
      id="links"
      class="reveal font-heading text-2xl font-medium tracking-tight text-charcoal md:text-3xl"
    >
      Links
    </h2>

    <ul class="mt-8 grid gap-3 md:grid-cols-4">
      {
        links.map((l) => (
          <li class="reveal">
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="block border border-stone bg-cream px-4 py-3 font-display text-sm text-charcoal transition-colors hover:border-charcoal"
            >
              <span class="block">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
