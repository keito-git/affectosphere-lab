---
import BaseLayout from "../layouts/BaseLayout.astro";
import Img from "../components/Img.astro";

// Education timeline (researchmap, 2026-05-30).  Newest at top.
const education = [
  {
    period: "2025/04 — present",
    degree: "博士後期課程",
    program: "大学院商学研究科 商学専攻",
    institution: "関西大学",
  },
  {
    period: "2023/04 — 2025/03",
    degree: "修士(データサイエンス)",
    program: "大学院データサイエンス研究科 博士前期課程",
    institution: "滋賀大学",
  },
  {
    period: "2020/04 — 2023/03",
    degree: "(中退・飛び級進学)",
    program: "地域共創学群 経営学専攻",
    institution: "札幌大学",
    note: "大学院への飛び級進学のため、3年次修了時点で中退。",
  },
];

// Current affiliations & research positions (researchmap).
const affiliations = [
  {
    period: "2025/04 — present",
    affiliation: "関西大学 大学院商学研究科 商学専攻",
    role: "博士後期課程",
  },
  {
    period: "2025/04 — present",
    affiliation: "滋賀大学 データサイエンス・AIイノベーション研究推進センター",
    role: "客員研究員",
  },
  {
    period: "2025/04 — present",
    affiliation: "日本セーフティソサイエティ研究センター",
    role: "研究員",
  },
  {
    period: "2025/12 — 2026/03",
    affiliation: "立命館大学 立命館グローバル・イノベーション研究機構",
    role: "客員研究員",
  },
  {
    period: "2025/04 — present",
    affiliation:
      "JST 次世代研究者挑戦的研究プログラム(SPRING)",
    role: "関西大学 SPRING スカラシップ研究学生",
  },
];

// "2025/04 — present" -> "2025.04 – present", so the column lines up with the
// period column used on the Grants list.
function formatPeriod(period: string): string {
  return period
    .split(/\s*[\u2013\u2014]\s*/)
    .map((part) => {
      const m = part.trim().match(/^(\d{4})\s*\/\s*(\d{1,2})$/);
      return m ? `${m[1]}.${m[2].padStart(2, "0")}` : part.trim();
    })
    .join(" \u2013 ");
}

// External profile links.
const links = [
  { label: "researchmap", href: "https://researchmap.jp/keito_inoshita" },
  { label: "ORCID", href: "https://orcid.org/0009-0006-6854-7231" },
  { label: "X (Twitter)", href: "https://x.com/keito0data" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  },
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://lab.affectosphere.group/about/#person",
  name: "Keito Inoshita",
  alternateName: "井下 敬翔",
  url: "https://lab.affectosphere.group/about/",
  jobTitle: "計算的感情知能（Computational Affective Intelligence）研究者",
  description:
    "AI に感情知能を与える研究者。感情の読み取りから、保持・推論・生成・相互作用・社会への定着までを Computational Affective Intelligence というひと続きの体系として扱う。",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "関西大学 大学院商学研究科" },
    { "@type": "CollegeOrUniversity", name: "滋賀大学 データサイエンス・AIイノベーション研究推進センター" },
    { "@type": "Organization", name: "日本セーフティソサイエティ研究センター" },
  ],
  knowsAbout: [
    "Computational Affective Intelligence",
    "Affective Computing",
    "感情AI",
    "大規模言語モデル",
    "感情認識",
    "不確実性の定量化",
    "感情データ生成",
    "AI倫理",
  ],
  sameAs: [
    "https://researchmap.jp/keito_inoshita",
    "https://orcid.org/0009-0006-6854-7231",
    "https://x.com/keito0data",
    "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  ],
  worksFor: { "@id": "https://lab.affectosphere.group/#organization" },
};
---

<BaseLayout jsonLd={personLd}
  title="井下敬翔 — 計算的感情知能（CAI）研究者"
  description="井下敬翔。AIに感情知能を与える研究者。計算的感情知能（Computational Affective Intelligence）を軸に、感情の認識・表現・推論・生成から倫理まで。経歴・所属・研究業績。"
  fullBleed
>
  <!-- Header on the dark observation surface, as on the other sections. -->
  <section class="surface-ink relative overflow-hidden" aria-labelledby="about-heading">
    <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-content page-x pb-12 pt-16 md:pb-16 md:pt-20">
      <p class="eyebrow reveal">About</p>
      <h1
        id="about-heading"
        class="reveal mt-5 font-display font-semibold tracking-tight text-[#F4F2ED]"
        style="font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1;"
      >
        Keito Inoshita
      </h1>
      <p class="reveal mt-2 font-display text-[#CFCBC2]" style="font-size: clamp(0.95rem, 1.2vw, 1.2rem);">
        井下 敬翔
      </p>
      <p
        class="reveal mt-8 max-w-[72rem] font-display text-[#CFCBC2]"
        style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
      >
        計算的感情知能（Computational Affective Intelligence）研究者。Affectosphere Group 主宰。
      </p>
    </div>
  </section>

  <!-- Identity card: portrait + short bio side by side. -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="about-profile">
    <header class="reveal">
      <p class="eyebrow">01 &mdash; Profile</p>
      <h2
        id="about-profile"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        プロフィール
      </h2>
    </header>
    <div class="mt-10 grid gap-10 md:grid-cols-[18rem_minmax(0,1fr)] md:gap-14">
    <div class="reveal">
      <div class="aspect-square w-full overflow-hidden border border-stone bg-cream">
        <Img src="/people/keito-inoshita.jpg" alt="Keito Inoshita" class="h-full w-full object-cover" />
      </div>
      <p class="mt-4 font-sans text-[0.75rem] uppercase tracking-[0.14em] text-slate font-medium">
        井下 敬翔 &middot; Keito Inoshita
      </p>
    </div>

    <div>
      <p class="eyebrow reveal">Bio</p>
      <p
        id="bio"
        class="reveal mt-3 max-w-[46rem] font-display text-lg leading-relaxed text-charcoal md:text-xl"
        style="line-height: 1.72;"
      >
        AI に感情知能を与える研究をしている。
        感情の読み取りから、保持・推論・生成・相互作用・社会への定着までをひと続きの体系として扱い、
        これを Computational Affective Intelligence（CAI）と呼んでいる。
        関西大学大学院、滋賀大学 DS・AI研究推進センター、
        日本セーフティソサイエティ研究センターに所属し、
        多様な企業と連携しながら AI × 感情の研究開発を進めている。
        Affectosphereを立ち上げ、
        AIを用いた人間の感情の生成・認識・理解から、人間とのインタラクション、
        CAIの倫理や哲学までを一貫して研究を行っている。
        最終的に目指すのは、人間を超える EQ を備えた AI の実現である。
      </p>

      <p class="eyebrow reveal mt-12">Research Statement</p>
      <div class="reveal mt-3 max-w-[46rem] space-y-5 font-display text-base leading-relaxed text-charcoal md:text-lg" style="line-height: 1.72;">
        <p>
          研究の問いは一貫している ―
          <em class="italic">どうすれば、AI は人間の感情をその豊かさを損なわずに扱えるか</em>。
          感情は曖昧で多義的でありながら、社会のあらゆる場面で人の判断と関係に影響を与えている。
          そのあいまいさを切り捨てずに計算の対象とすることが、研究の出発点である。
        </p>
        <p>
          このために、AIを用いた人間の感情の <em class="italic">生成・認識・理解</em> から、
          <em class="italic">人間とのインタラクション</em>、そして
          <em class="italic">CAIの倫理や哲学</em> までを一貫して研究している。
          認識は曖昧さを分布として推定する技術、生成と表出は人とAIが感情を介して対話する界面、
          理解は人がそもそも感情をどう経験しているかという問いの再考、
          そして倫理や哲学はCAIの社会的位置づけを構造的に問い直す試みである。
        </p>
        <p>
          学術研究にとどまらず、多様な企業との連携を通じて、
          CAIが実装され社会に届く現場の知見も研究の土台に取り込んでいる。
          目指すのは、人間を超える EQ を備えた AI の輪郭を、
          技術と人文、そして実装と理論の往復のなかで描き出していくことである。
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Education -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="education"
  >
    <header class="reveal">
      <p class="eyebrow">02 &mdash; Education</p>
      <h2
        id="education"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        学歴
      </h2>
    </header>
    <ul class="mt-10 border-t border-stone">
      {
        education.map((row) => (
          <li class="reveal grid gap-x-8 gap-y-3 border-b border-stone py-7 md:grid-cols-[11rem_minmax(0,1fr)] md:items-start">
            <span class="whitespace-nowrap font-label text-[0.72rem] tabular-nums tracking-[0.1em] text-slate">
              {formatPeriod(row.period)}
            </span>
            <div class="min-w-0">
              <h3 class="font-display text-lg leading-snug text-charcoal md:text-xl">
                {row.degree}
              </h3>
              <div class="mt-2.5 border-l border-amber/50 pl-3">
                <p class="font-display text-sm leading-relaxed text-charcoal/85 md:text-base">
                  {row.program}
                </p>
                <p class="mt-1 font-sans text-xs leading-relaxed text-slate md:text-sm">
                  {row.institution}
                </p>
              </div>
              {row.note && (
                <p class="mt-3 font-sans text-xs leading-relaxed text-slate md:text-sm">{row.note}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Affiliations -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="affiliations"
  >
    <header class="reveal">
      <p class="eyebrow">03 &mdash; Affiliations</p>
      <h2
        id="affiliations"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        所属
      </h2>
    </header>
    <ul class="mt-10 border-t border-stone">
      {
        affiliations.map((a) => (
          <li class="reveal grid gap-x-8 gap-y-3 border-b border-stone py-7 md:grid-cols-[11rem_minmax(0,1fr)] md:items-start">
            <span class="whitespace-nowrap font-label text-[0.72rem] tabular-nums tracking-[0.1em] text-slate">
              {formatPeriod(a.period)}
            </span>
            <div class="min-w-0">
              <h3 class="font-display text-lg leading-snug text-charcoal md:text-xl">
                {a.affiliation}
              </h3>
              <p class="mt-2.5 border-l border-amber/50 pl-3 font-sans text-xs leading-relaxed text-slate md:text-sm">
                {a.role}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Links + CV -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="links"
  >
    <header class="reveal">
      <p class="eyebrow">04 &mdash; Links</p>
      <h2
        id="links"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        リンク
      </h2>
    </header>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 md:grid-cols-4">
      {
        links.map((l) => (
          <li class="reveal">
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="block border border-stone bg-cream px-4 py-3 font-display text-sm text-charcoal transition-colors hover:border-amber hover:text-amber-deep"
            >
              <span class="block">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
