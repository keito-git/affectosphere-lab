---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationItem from "../components/PublicationItem.astro";
import {
  allPublications,
  allYears,
  groupByYear,
  kindLabel,
  kindOrder,
  type PublicationKind,
} from "../data/publications";
import { caiStages, publicationStage } from "../data/research-map";
import StatPanel from "../components/StatPanel.astro";

const yearGroups = groupByYear(allPublications);

// Summary figures, all derived from the list itself.
const byKind = kindOrder
  .map((k) => ({ label: kindLabel[k], value: allPublications.filter((p) => p.kind === k).length }))
  .filter((r) => r.value > 0)
  .sort((a, b) => b.value - a.value);
const byYear = [...allYears]
  .sort((a, b) => a - b)
  .map((y) => ({ label: String(y), value: allPublications.filter((p) => p.year === y).length }));
const firstAuthorCount = allPublications.filter((p) => p.firstAuthor).length;
const awardedCount = allPublications.filter((p) => p.award).length;
const yearSpan = `${Math.min(...allYears)} — ${Math.max(...allYears)}`;

// Stage filter: the same stages the research map uses, so a visitor can go from
// "this part of CAI is thin" straight to the work behind it.
const stageFilters = [
  { key: "all", label: "All" },
  ...caiStages
    .map((st) => ({
      key: st.id,
      label: st.label,
      count: allPublications.filter((p) => publicationStage[p.slug] === st.id).length,
    }))
    .filter((f) => f.count > 0),
];

const kindFilters: { key: "all" | PublicationKind; label: string }[] = [
  { key: "all", label: "All" },
  ...kindOrder.map((k) => ({ key: k, label: kindLabel[k] })),
];

const yearFilters: { key: "all" | number; label: string }[] = [
  { key: "all", label: "All" },
  ...allYears.map((y) => ({ key: y, label: `${y}` })),
];

// The publication list as structured data, so a search engine reads this as a
// body of scholarly work rather than a page of text. Only fields the list
// actually holds are emitted.
const publicationsLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Publications — Affectosphere Group",
  numberOfItems: allPublications.length,
  itemListElement: allPublications.map((pub, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "ScholarlyArticle",
      name: pub.title,
      author: pub.authors.split(",").map((a) => ({ "@type": "Person", name: a.trim() })),
      datePublished: pub.date,
      publisher: pub.venue,
      ...(pub.href ? { url: pub.href, sameAs: pub.href } : {}),
    },
  })),
};
---

<BaseLayout jsonLd={publicationsLd}
  title="業績 — 感情AI・LLM研究の論文"
  description="Affectosphere Group（井下敬翔）の論文・国際会議発表の一覧。感情AI・LLM・不確実性・感情データ生成を中心に、年・種別・CAIの段で絞り込めます。"
  fullBleed
>
  <section class="mx-auto max-w-content page-x pt-24 md:pt-32">
    <h1
      class="reveal font-display font-medium tracking-tight text-charcoal"
      style="font-size: clamp(2.25rem, 4.5vw, 4rem); line-height: 1.12;"
    >
      Publications
    </h1>
  </section>

  <section class="mx-auto mt-section-sm max-w-content page-x" aria-label="概要">
    <StatPanel
      headline={allPublications.length}
      headlineLabel="件の業績"
      headlineNote={yearSpan}
      highlights={[
        { label: "筆頭著者", value: firstAuthorCount },
        { label: "受賞", value: awardedCount },
      ]}
      groups={[
        { title: "種別", rows: byKind },
        { title: "年別", rows: byYear },
      ]}
    />
  </section>

  <!-- Filters: kind × year (both client-side, AND-combined). -->
  <section class="mx-auto mt-section-sm max-w-content page-x" aria-label="Filters">
    <div class="reveal space-y-5" data-pub-filter>
      <div>
        <p class="mb-2 font-display text-sm italic text-slate">Kind</p>
        <div class="flex flex-wrap items-center gap-2" data-kind-bar>
          {
            kindFilters.map((f, idx) => (
              <button
                type="button"
                class:list={[
                  "btn-ghost",
                  idx === 0 ? "bg-charcoal text-ivory border-charcoal" : "",
                ]}
                data-filter-kind={f.key}
                aria-pressed={idx === 0 ? "true" : "false"}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
      <div>
        <p class="mb-2 font-display text-sm italic text-slate">CAI の段</p>
        <div class="flex flex-wrap items-center gap-2" data-stage-bar>
          {
            stageFilters.map((f, idx) => (
              <button
                type="button"
                class:list={[
                  "btn-ghost",
                  idx === 0 ? "bg-charcoal text-ivory border-charcoal" : "",
                ]}
                data-filter-stage={f.key}
                aria-pressed={idx === 0 ? "true" : "false"}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-2 font-display text-sm italic text-slate">Year</p>
        <div class="flex flex-wrap items-center gap-2" data-year-bar>
          {
            yearFilters.map((f, idx) => (
              <button
                type="button"
                class:list={[
                  "btn-ghost",
                  idx === 0 ? "bg-charcoal text-ivory border-charcoal" : "",
                ]}
                data-filter-year={f.key}
                aria-pressed={idx === 0 ? "true" : "false"}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <p class="reveal mt-6 font-display text-sm italic text-slate">
      Total {allPublications.length} entries
      <span data-pub-count-visible class="ml-3 text-charcoal" />
    </p>
  </section>

  {
    yearGroups.map((group) => (
      <section
        class="mx-auto mt-section-sm max-w-content page-x"
        aria-labelledby={`year-${group.year}`}
        data-pub-year-section
        data-section-year={group.year}
      >
        <h2
          id={`year-${group.year}`}
          class="reveal mb-6 font-display text-4xl font-medium text-charcoal md:text-5xl"
        >
          {group.year}
        </h2>
        <ul class="w-full" data-pub-list>
          {group.items.map((pub) => (
            <PublicationItem pub={pub} />
          ))}
        </ul>
      </section>
    ))
  }

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>

<script>
  // Two-axis filter (kind × year). Both default to "all" and AND together.
  const root = document.querySelector<HTMLDivElement>("[data-pub-filter]");
  if (root) {
    const kindButtons = root.querySelectorAll<HTMLButtonElement>("[data-filter-kind]");
    const yearButtons = root.querySelectorAll<HTMLButtonElement>("[data-filter-year]");
    const stageButtons = root.querySelectorAll<HTMLButtonElement>("[data-filter-stage]");
    const sections = document.querySelectorAll<HTMLElement>(
      "[data-pub-year-section]"
    );
    const visibleCount = document.querySelector<HTMLSpanElement>(
      "[data-pub-count-visible]"
    );

    let currentKind: string = "all";
    let currentYear: string = "all";
    let currentStage: string = "all";

    function setActive(
      buttons: NodeListOf<HTMLButtonElement>,
      attr: string,
      value: string
    ) {
      buttons.forEach((b) => {
        const active = (b.getAttribute(attr) ?? "all") === value;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("bg-charcoal", active);
        b.classList.toggle("text-ivory", active);
        b.classList.toggle("border-charcoal", active);
      });
    }

    function applyFilters() {
      let total = 0;
      sections.forEach((section) => {
        const sectionYear = section.dataset.sectionYear ?? "";
        const yearMatch = currentYear === "all" || currentYear === sectionYear;
        if (!yearMatch) {
          section.style.display = "none";
          return;
        }
        const items = section.querySelectorAll<HTMLLIElement>("[data-pub-kind]");
        let visible = 0;
        items.forEach((li) => {
          const kindMatch =
            currentKind === "all" || li.dataset.pubKind === currentKind;
          const stageMatch =
            currentStage === "all" || li.dataset.pubStage === currentStage;
          const match = kindMatch && stageMatch;
          li.style.display = match ? "" : "none";
          if (match) visible += 1;
        });
        section.style.display = visible > 0 ? "" : "none";
        total += visible;
      });
      if (visibleCount) {
        visibleCount.textContent =
          currentKind === "all" && currentYear === "all" && currentStage === "all"
            ? ""
            : `/ Showing ${total}`;
      }
    }

    kindButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentKind = btn.getAttribute("data-filter-kind") ?? "all";
        setActive(kindButtons, "data-filter-kind", currentKind);
        applyFilters();
      });
    });
    stageButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentStage = btn.getAttribute("data-filter-stage") ?? "all";
        setActive(stageButtons, "data-filter-stage", currentStage);
        applyFilters();
      });
    });
    yearButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentYear = btn.getAttribute("data-filter-year") ?? "all";
        setActive(yearButtons, "data-filter-year", currentYear);
        applyFilters();
      });
    });
  }
</script>
