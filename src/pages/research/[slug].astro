---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchDomainPage from "../../components/ResearchDomainPage.astro";
import { researchDomains } from "../../data/research-domains";
import { allPublications } from "../../data/publications";
import { publicationDomain } from "../../data/research-map";

export function getStaticPaths() {
  return researchDomains.map((d) => ({
    params: { slug: d.slug },
    props: { domain: d },
  }));
}

const { domain } = Astro.props;
const siblings = researchDomains.filter((d) => d.slug !== domain.slug);
const pubs = allPublications
  .filter((pub) => publicationDomain[pub.slug] === domain.slug)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title={domain.title} description={domain.summary} fullBleed>
  <ResearchDomainPage domain={domain} siblings={siblings} pubs={pubs} locale="ja" />
</BaseLayout>
