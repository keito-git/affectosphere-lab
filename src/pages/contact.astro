---
import BaseLayout from "../layouts/BaseLayout.astro";
// Services first, then the general inquiry form: one page for anything that
// involves getting in touch, whether or not it is about a paid engagement.
// The form posts to Netlify Forms; submissions land in the Netlify dashboard
// and are emailed to contact@affectosphere.group when notifications are on.

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://lab.affectosphere.group/contact/#service",
  name: "Affectosphere Group — CAI・LLMの企業向けサービス",
  description:
    "CAI と大規模言語モデルの研究知見を、企業内研修・講演・導入支援という形で実務に届けます。不確実性の扱い、バイアス監査、AI に任せる範囲の設計まで。",
  url: "https://lab.affectosphere.group/contact/",
  provider: { "@id": "https://lab.affectosphere.group/#organization" },
  areaServed: { "@type": "Country", name: "日本" },
  availableLanguage: ["ja", "en"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "サービス",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "企業内研修・勉強会", description: "CAI、LLMガバナンス、AI倫理、機械学習の不確実性。経営層から実務者まで、テーマと深さを調整します。" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "講演・登壇", description: "業界カンファレンス、社内イベント、自治体の有識者枠まで。" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "導入支援・コンサルティング", description: "AI戦略の方針づくり、製品仕様の妥当性確認、リスク評価、ガバナンス整備。" } },
    ],
  },
};
---

<BaseLayout jsonLd={serviceLd}
  title="企業向けサービス・お問い合わせ"
  description="Affectosphere Group の企業向けサービス（研修・講演・導入支援）と、お問い合わせ窓口。共同研究・グループへの参加希望・取材のご連絡も受け付けています。"
  fullBleed
>
  <!-- Header on the dark observation surface, as on the other sections. -->
  <section class="surface-ink relative overflow-hidden" aria-labelledby="contact-heading">
    <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-content page-x pb-12 pt-16 md:pb-16 md:pt-20">
      <p class="eyebrow reveal">Contact</p>
      <h1
        id="contact-heading"
        class="reveal mt-5 font-display font-semibold tracking-tight text-[#F4F2ED]"
        style="font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1;"
      >
        サービスとお問い合わせ
      </h1>
      <p
        class="reveal mt-8 max-w-[72rem] font-display text-[#CFCBC2]"
        style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
      >
        研修・講演・導入支援の内容と、お問い合わせの窓口をまとめています。共同研究・グループへの参加希望・取材のご連絡も、同じフォームから受け付けています。
      </p>
    </div>
  </section>

  <!-- 01 — What the lab offers to companies -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="svc-intro">
    <header class="reveal">
      <p class="eyebrow">01 &mdash; For business</p>
      <h2
        id="svc-intro"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        AI に感情知能を与える技術を、現場と一緒につくる。
      </h2>
      <p
        class="mt-5 max-w-[72rem] font-display text-charcoal/85"
        style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
      >
        感情を測る装置を売るのではありません。LLM やエージェントが感情を理解し、推論し、不確実性を扱えるようにする：そのための土台をつくっています。その過程で得た知見を、研修・講演・導入支援という形でお渡しします。
      </p>
    </header>

    <div class="reveal mt-10 max-w-[72rem] space-y-5">
      <p class="font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.72;">
        既存の感情認識AIの多くは「顔や声から感情を当てる」方向に進んできました。私たちが向かうのはその先です。感情を読み取るだけでなく、確率として保持し、それを前提に考え、人に返す。この一連の働きを LLM やエージェントに持たせるための土台を、私たちは <span class="text-amber-deep">Affective Intelligence Layer</span>（感情知能レイヤー）と呼んでいます。
      </p>
      <p class="font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.72;">
        層そのものはまだ研究の途上にあります。いま企業にお渡しできるのは、その構築の過程で積み上がった判断材料です：不確実性をどう扱うか、バイアスをどう監査するか、AI に何を任せて何を残すか。研修・講演・導入支援の 3 形態で、組織の状況に合わせた関わり方を選んでいただけます。
      </p>
    </div>
  </section>

  <!-- 02 — The three engagement forms -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="svc-menu">
    <header class="reveal">
      <p class="eyebrow">02 &mdash; Service menu</p>
      <h2
        id="svc-menu"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        3 つの関わり方。
      </h2>
    </header>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <!-- 研修 -->
      <article class="reveal border border-stone bg-cream p-8 md:p-10">
        <p class="font-display text-sm italic text-slate">01</p>
        <h3 class="mt-3 font-display text-2xl font-medium text-charcoal md:text-3xl">
          企業内研修・勉強会
        </h3>
        <p class="mt-5 font-display text-base leading-relaxed text-charcoal" style="line-height:1.85;">
          CAI、LLM ガバナンス、AI 倫理、機械学習の不確実性：経営層・マネージャー・エンジニア・コンプライアンス担当のいずれにも届くよう、テーマと深さを調整します。1 回 90 分の単発から、複数回シリーズまで柔軟に対応します。
        </p>
        <p class="mt-6 font-sans text-xs uppercase tracking-[0.14em] text-slate font-medium">
          こんなテーマで
        </p>
        <ul class="mt-3 space-y-2 font-display text-sm text-charcoal">
          <li>・LLM 時代のリスク管理(GDPR / EU AI Act 入門)</li>
          <li>・CAI を業務に取り入れる際の設計原則</li>
          <li>・AI の不確実性をビジネス判断にどう使うか</li>
          <li>・コンテンツ AI とユーザー保護の境界線</li>
        </ul>
      </article>

      <!-- 講演 -->
      <article class="reveal border border-stone bg-cream p-8 md:p-10">
        <p class="font-display text-sm italic text-slate">02</p>
        <h3 class="mt-3 font-display text-2xl font-medium text-charcoal md:text-3xl">
          講演・登壇
        </h3>
        <p class="mt-5 font-display text-base leading-relaxed text-charcoal" style="line-height:1.85;">
          業界カンファレンス、社内イベント、業界団体のセミナー、自治体の有識者枠まで、登壇形式の話題提供をいたします。聴衆の専門性に合わせ、研究の最前線をそのまま伝えるか、ビジネス示唆を抽出して届けるかをすり合わせます。
        </p>
        <p class="mt-6 font-sans text-xs uppercase tracking-[0.14em] text-slate font-medium">
          得意な切り口
        </p>
        <ul class="mt-3 space-y-2 font-display text-sm text-charcoal">
          <li>・CAI の社会実装と倫理的境界</li>
          <li>・LLM が生む新しいバイアスと監査の実務</li>
          <li>・AI for Science：各分野での AI 活用事例</li>
          <li>・生成 AI 時代の働き方とウェルビーイング</li>
        </ul>
      </article>

      <!-- コンサル -->
      <article class="reveal border border-stone bg-cream p-8 md:p-10">
        <p class="font-display text-sm italic text-slate">03</p>
        <h3 class="mt-3 font-display text-2xl font-medium text-charcoal md:text-3xl">
          コンサルティング
        </h3>
        <p class="mt-5 font-display text-base leading-relaxed text-charcoal" style="line-height:1.85;">
          自社プロダクトや業務プロセスへの AI 導入を、設計段階から伴走します。AI 戦略の方針づくり、製品仕様の妥当性確認、リスク評価、ガバナンス整備など、組織の段階に合わせて関わり方を設計します。月次契約から案件単位まで対応可能です。
        </p>
        <p class="mt-6 font-sans text-xs uppercase tracking-[0.14em] text-slate font-medium">
          相談される領域
        </p>
        <ul class="mt-3 space-y-2 font-display text-sm text-charcoal">
          <li>・AI プロダクトの設計・要件定義・第三者レビュー</li>
          <li>・社内 AI ガバナンス・倫理ガイドラインの策定</li>
          <li>・データセット設計とバイアス監査の枠組み構築</li>
          <li>・研究開発部門の AI 戦略立案</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- 03 — Track record. Real engagements only; nothing is described beyond
       what actually took place. -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="svc-track">
    <header class="reveal">
      <p class="eyebrow">03 &mdash; Track record</p>
      <h2
        id="svc-track"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        これまでの取り組み。
      </h2>
    </header>

    <div class="reveal mt-8">
      <p class="max-w-[72rem] font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.72;">
          企業の研究所から中学校の教室まで、相手の前提がまったく違う場で話してきました。
          CAI は、技術としてよりも先に「これをどこまで人に向けてよいのか」が問われる領域です。
          その問いは、現場ごとに形を変えて現れます。
        </p>

        <ul class="mt-10 divide-y divide-stone border-t border-stone">
          <li class="grid gap-2 py-6 md:grid-cols-[24rem_minmax(0,1fr)] md:gap-10">
            <p class="font-display text-base font-medium text-charcoal">自動車メーカー・同社中央研究所</p>
            <p class="font-display text-base leading-relaxed text-slate">
              AI 技術の導入支援、およびCAI に関するワークショップの開催。
            </p>
          </li>
          <li class="grid gap-2 py-6 md:grid-cols-[24rem_minmax(0,1fr)] md:gap-10">
            <p class="font-display text-base font-medium text-charcoal">民間事業会社</p>
            <p class="font-display text-base leading-relaxed text-slate">
              AI 技術の導入支援、およびCAI に関するワークショップの開催。
            </p>
          </li>
          <li class="grid gap-2 py-6 md:grid-cols-[24rem_minmax(0,1fr)] md:gap-10">
            <p class="font-display text-base font-medium text-charcoal">国立大学教育学部附属中学校</p>
            <p class="font-display text-base leading-relaxed text-slate">
              生徒に向けたCAI の解説と質疑応答。
            </p>
          </li>
        </ul>
    </div>
  </section>

  <!-- 04 — Pricing -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="svc-pricing">
    <header class="reveal">
      <p class="eyebrow">04 &mdash; Pricing</p>
      <h2
        id="svc-pricing"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        内容・規模・期間に応じてお見積もり
      </h2>
    </header>

    <div class="reveal mt-8">
      <p class="max-w-[72rem] font-display text-base leading-relaxed text-charcoal md:text-lg" style="line-height:1.85;">
        各サービスの料金は、テーマ・対象人数・回数・準備期間・成果物の有無などにより変動します。まずは初回 30 分の無料オンライン相談で、課題と方向性をすり合わせさせてください。そのうえで内容を整理し、お見積もりをご提示します。共同研究のご相談は <a href="/ai-for-science/" class="link-amber">AI for Science</a> ページもご覧ください。
      </p>
    </div>

    <div class="reveal mt-10 grid gap-8 md:grid-cols-2">
      <div class="border border-stone bg-cream p-8 md:p-10">
        <p class="font-display text-sm italic text-slate">初回オンライン相談</p>
        <p class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl">
          無料 <span class="text-base italic text-slate">(30 分)</span>
        </p>
        <p class="mt-4 font-display text-base leading-relaxed text-charcoal" style="line-height:1.85;">
          まずは課題感とご希望をお聞かせください。研修・講演・コンサルのどれが合うか、あるいは別の形が良いかを一緒に整理します。
        </p>
        <p class="mt-6">
          <a href="#contact-form" class="btn-solid">
            お問い合わせ
            <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
      <div class="border border-stone bg-cream p-8 md:p-10">
        <p class="font-display text-sm italic text-slate">本契約</p>
        <p class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl">
          要相談
        </p>
        <p class="mt-4 font-display text-base leading-relaxed text-charcoal" style="line-height:1.85;">
          初回相談で内容を整理した後、お見積もりと契約書をご提示します。請求・契約は関西大学の所定手続きに準じます。
        </p>
      </div>
    </div>
  </section>

  <!-- 05 — General inquiry form -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="contact-form">
    <header class="reveal">
      <p class="eyebrow">05 &mdash; Contact</p>
      <h2
        id="contact-form"
        class="mt-3 scroll-mt-[9rem] font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        お問い合わせ
      </h2>
    </header>

    <div class="mt-10">
    <div class="reveal border border-stone bg-cream p-8 md:p-12">
      <h3 class="font-display text-lg font-medium text-charcoal md:text-xl">
        お問い合わせフォーム
      </h3>
      <p class="mt-3 font-display text-sm italic text-slate">
        送信内容は Affectosphere Group まで届きます。通常 2–3 営業日以内にご返信します。
      </p>

      <form
        class="mt-8 grid gap-6 md:grid-cols-2"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>
            この欄は空にしてください:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <label class="flex flex-col gap-2 md:col-span-1">
          <span class="font-display text-sm italic text-slate">お名前</span>
          <input
            type="text"
            name="name"
            required
            class="border border-stone bg-ivory px-4 py-3 font-display text-base text-charcoal focus:border-charcoal focus:outline-none"
            placeholder="例: 山田 太郎"
          />
        </label>
        <label class="flex flex-col gap-2 md:col-span-1">
          <span class="font-display text-sm italic text-slate">ご所属(任意)</span>
          <input
            type="text"
            name="affiliation"
            class="border border-stone bg-ivory px-4 py-3 font-display text-base text-charcoal focus:border-charcoal focus:outline-none"
            placeholder="例: ○○大学 / 株式会社□□ / フリーランス"
          />
        </label>
        <label class="flex flex-col gap-2 md:col-span-1">
          <span class="font-display text-sm italic text-slate">返信先メール</span>
          <input
            type="email"
            name="email"
            required
            class="border border-stone bg-ivory px-4 py-3 font-display text-base text-charcoal focus:border-charcoal focus:outline-none"
            placeholder="example@your-domain.com"
          />
        </label>
        <label class="flex flex-col gap-2 md:col-span-1">
          <span class="font-display text-sm italic text-slate">ご用件</span>
          <select
            name="purpose"
            required
            class="border border-stone bg-ivory px-4 py-3 font-display text-base text-charcoal focus:border-charcoal focus:outline-none"
          >
            <option value="">選択してください</option>
            <option value="共同研究のご相談">共同研究のご相談</option>
            <option value="Groupへの参加希望">Group への参加希望</option>
            <option value="企業からのご提案">企業からのご提案</option>
            <option value="取材のご依頼">取材のご依頼</option>
            <option value="講演・登壇のご依頼">講演・登壇のご依頼</option>
            <option value="その他">その他</option>
          </select>
        </label>
        <label class="flex flex-col gap-2 md:col-span-2">
          <span class="font-display text-sm italic text-slate">お問い合わせ内容</span>
          <textarea
            name="message"
            rows="8"
            required
            class="border border-stone bg-ivory px-4 py-3 font-display text-base text-charcoal focus:border-charcoal focus:outline-none"
            placeholder="ご用件の詳細、ご相談内容を自由にお書きください。"
          ></textarea>
        </label>

        <div class="md:col-span-2 flex justify-end">
          <button type="submit" class="btn-solid">
            送信する
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </form>
    </div>
    </div>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
