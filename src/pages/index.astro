---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import Hero from "../components/Hero.astro";
import PublicationItem from "../components/PublicationItem.astro";
import NewsItem from "../components/NewsItem.astro";
import { recentPublications } from "../data/publications";
import { recentNews } from "../data/news";
import { researchDomains, aiForScienceImage } from "../data/research-domains";
import { webp } from "../lib/images";
import Img from "../components/Img.astro";

// Home grid: the ten affective-AI domains shown as 5 rows × 2 cols,
// followed by the AI for Science card spanning both columns on row 6.
// Each affective-AI domain links to /research/<slug>/; AI for Science
// links to its own top-level page.
type DomainCard = { title: string; summary: string; href: string; image: string };

const affectiveDomainCards: DomainCard[] = researchDomains.map((d) => ({
  title: d.title,
  summary: d.summary,
  href: `/research/${d.slug}/`,
  image: d.image,
}));

const aiForScienceCard: DomainCard = {
  title: "AI for Science",
  summary:
    "感情以外の科学領域へのAI応用。生物学・教育安全など、分野横断の共同研究をここで束ねています。",
  href: "/ai-for-science/",
  image: aiForScienceImage,
};
---

<BaseLayout fullBleed>
  <Hero />

  <!-- Section 2: Affectosphereとは (short intro + read-more) -->
  <section
    class="mx-auto mt-section grid max-w-content gap-12 page-x md:grid-cols-[1fr_2fr]"
    aria-labelledby="affecto-intro"
  >
    <div>
      <p class="reveal font-sans text-lg font-medium tracking-wide text-slate">
        Vision
      </p>
      <h2
        id="affecto-intro"
        class="reveal mt-3 whitespace-nowrap font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        Affectosphereとは
      </h2>
    </div>
    <div class="reveal">
      <p
        class="font-display text-lg leading-relaxed text-charcoal md:text-xl"
        style="line-height: 1.75;"
      >
        感情は大気のように社会を包み、人々の判断・関係・心のあり方を静かに形づくっている。
        我々はその<span class="text-amber-deep">遍在する情動圏</span>を、
        AIで読み解き、人にとって最適な形へとAIを調えていくことで、
        AI時代においても誰もが心のゆとりを持てる社会へとつなぐ研究を進める。
      </p>
      <p class="mt-6">
        <a href="/affectosphere/" class="link-amber font-heading text-sm tracking-wide">
          Visionを読む &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 2.5: What Computational Affective Intelligence is -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="cai-definition">
    <div class="grid gap-12 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow reveal">Definition</p>
        <h2
          id="cai-definition"
          class="reveal mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
        >
          CAI とは何か
        </h2>
      </div>
      <div class="reveal">
        <p
          class="font-display text-lg leading-relaxed text-charcoal md:text-xl"
          style="line-height: 1.75;"
        >
          感情を認識するAIのことではない。感情の<span class="text-amber-deep">主観性・多義性・揺らぎ</span>を保ったまま、
          人の感情知性を高める側にAIを置く——その設計の体系を、
          我々は Computational Affective Intelligence（CAI）と呼ぶ。
        </p>
        <p class="mt-6 font-display text-base leading-relaxed text-slate md:text-lg">
          感情を一つの正解へ潰す技術は、誰かの解釈を「客観」として制度化してしまう。
          CAI が引き受けるのは、その手前にある問いである。
        </p>
      </div>
    </div>

    <ol class="reveal mt-14 grid gap-px border border-stone bg-stone md:grid-cols-3">
      <li class="bg-ivory p-7">
        <p class="font-label text-[0.72rem] tracking-[0.18em] text-amber-deep">01</p>
        <h3 class="mt-4 font-display text-xl font-medium text-charcoal">感情は確率分布である</h3>
        <p class="mt-3 font-display text-base leading-relaxed text-slate">
          一点の正解に潰さない。複数の解釈が併存したまま学習し、推論する。
        </p>
      </li>
      <li class="bg-ivory p-7">
        <p class="font-label text-[0.72rem] tracking-[0.18em] text-amber-deep">02</p>
        <h3 class="mt-4 font-display text-xl font-medium text-charcoal">曖昧さを測り、表現する</h3>
        <p class="mt-3 font-display text-base leading-relaxed text-slate">
          不確実性を欠陥ではなく情報として扱い、どこまで言えるかを一緒に返す。
        </p>
      </li>
      <li class="bg-ivory p-7">
        <p class="font-label text-[0.72rem] tracking-[0.18em] text-amber-deep">03</p>
        <h3 class="mt-4 font-display text-xl font-medium text-charcoal">AI は判定者ではなく鏡</h3>
        <p class="mt-3 font-display text-base leading-relaxed text-slate">
          感情を解釈する権利を人の側に残し、AI は人の感情知性を引き上げる側に立つ。
        </p>
      </li>
    </ol>
  </section>


  <!-- Section 3: Ten research domains (2 columns × 5 rows) -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="research-domains">
    <header class="reveal mb-10 max-w-prose md:mb-14">
      <p class="font-sans text-lg font-medium tracking-wide text-slate">
        主な研究テーマ
      </p>
      <h2
        id="research-domains"
        class="mt-3 font-display text-3xl font-medium tracking-tight text-charcoal md:text-4xl"
      >
        ラボの研究領域。
      </h2>
      <p class="mt-4 font-display text-base leading-relaxed text-slate md:text-lg">
        感情と社会、技術と倫理。Affectosphere Groupが取り組んでいる十の領域です。
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        affectiveDomainCards.map((d) => (
          <a
            href={d.href}
            class="reveal group relative flex h-full flex-col overflow-hidden border border-stone shadow-card transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-[1.02]"
              style={`background-image: url('${webp(d.image, 800)}');`}
              aria-hidden="true"
            />
            <div
              class="absolute inset-0 bg-ivory/75 transition-colors duration-300 group-hover:bg-ivory/65"
              aria-hidden="true"
            />
            <div class="relative z-10 flex h-full flex-col p-6 min-h-[180px]">
              <h3 class="font-display text-xl font-bold text-charcoal md:text-2xl">
                {d.title}
              </h3>
              <p class="mt-3 font-display text-base font-bold leading-relaxed text-charcoal">
                {d.summary}
              </p>
              <span class="mt-auto pt-4 font-heading text-sm font-bold tracking-wide text-charcoal transition-colors group-hover:text-amber-deep">
                詳しく見る &rarr;
              </span>
            </div>
          </a>
        ))
      }
      <a
        href={aiForScienceCard.href}
        class="reveal group relative flex h-full flex-col overflow-hidden border border-stone shadow-card transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover md:col-span-2"
      >
        <div
          class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-[1.02]"
          style={`background-image: url('${webp(aiForScienceCard.image, 800)}');`}
          aria-hidden="true"
        />
        <div
          class="absolute inset-0 bg-ivory/75 transition-colors duration-300 group-hover:bg-ivory/65"
          aria-hidden="true"
        />
        <div class="relative z-10 flex h-full flex-col p-6 min-h-[180px]">
          <h3 class="font-display text-xl font-bold text-charcoal md:text-2xl">
            {aiForScienceCard.title}
          </h3>
          <p class="mt-3 font-display text-base font-bold leading-relaxed text-charcoal">
            {aiForScienceCard.summary}
          </p>
          <span class="mt-auto pt-4 font-heading text-sm font-bold tracking-wide text-charcoal transition-colors group-hover:text-amber-deep">
            詳しく見る &rarr;
          </span>
        </div>
      </a>
    </div>

    <div class="reveal mt-10">
      <a href="/research/" class="link-amber font-heading text-sm tracking-wide">
        研究テーマ一覧へ &rarr;
      </a>
    </div>
  </section>

  <!-- Section 4: The research map -->
  <div class="mt-section">
    <ResearchMap locale="ja" />
  </div>

  <!-- Section 3.5: Looking for collaborators -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="lp-collab"
  >
    <div class="reveal border-l-2 border-amber/60 pl-6">
      <p class="font-display text-sm italic text-slate mb-3">Looking for collaborators</p>
      <h2
        id="lp-collab"
        class="font-display text-2xl font-medium text-charcoal md:text-3xl"
      >
        感情AIに関わる仲間を募集しています
      </h2>
      <p class="mt-4 font-display text-base leading-relaxed text-charcoal md:text-lg">
        感情AIの構築・活用などに興味関心がある学生・共同研究者・ビジネスマンなど、
        幅広く募集しています。
      </p>
      <p class="mt-6">
        <a href="/contact/" class="link-amber font-heading text-sm tracking-wide">
          お問い合わせ &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 4: Recent Publications -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="recent-pubs">
    <header class="reveal mb-10 max-w-prose md:mb-14">
      <h2
        id="recent-pubs"
        class="font-display text-3xl font-medium tracking-tight text-charcoal md:text-4xl"
      >
        新着論文
      </h2>
    </header>
    <ul class="w-full">
      {recentPublications.map((pub) => <PublicationItem pub={pub} hideStatus />)}
    </ul>
    <div class="reveal mt-10">
      <a href="/publications/" class="link-amber font-heading text-sm tracking-wide">
        論文一覧へ &rarr;
      </a>
    </div>
  </section>

  <!-- Section 2.5: Principal Investigator (brief introduction with portrait) -->
  <section
    class="mx-auto mt-section grid max-w-content gap-10 page-x md:grid-cols-[16rem_1fr] md:gap-14"
    aria-labelledby="pi-intro"
  >
    <div class="reveal">
      <div class="overflow-hidden border border-stone bg-cream aspect-square w-full max-w-[16rem]">
        <Img src="/people/keito-inoshita.jpg" alt="Keito Inoshita" class="h-full w-full object-cover" />
      </div>
    </div>
    <div>
      <p class="reveal font-display text-lg italic tracking-wide text-slate">
        Principal Investigator
      </p>
      <h2
        id="pi-intro"
        class="reveal mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        井下 敬翔
      </h2>
      <p class="reveal mt-2 font-display text-base text-slate">
        Keito Inoshita
      </p>

      <p class="reveal mt-3 font-label text-[0.72rem] uppercase tracking-[0.16em] text-amber-deep">
        Computational Affective Intelligence researcher
      </p>

      <div class="reveal mt-6 space-y-5 font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.85;">
        <p>
          AI に感情知能を与える研究をしている。
          感情を確率として測り、その曖昧さを保ったまま人に返す設計を、
          読み取りから生成・相互作用・倫理まで、ひと続きの体系として扱う。
          この体系を Computational Affective Intelligence（CAI）と呼び、その構築を研究の旗としている。
        </p>
        <p>
          関西大学大学院、滋賀大学 DS・AI研究推進センター、
          日本セーフティソサイエティ研究センターに所属し、
          多様な企業との連携を通じて社会実装も並行して進めている。
          最終的に見据えるのは、人間を超える EQ を備えた AI である。
        </p>
      </div>

      <p class="mt-8">
        <a href="/about/" class="link-amber font-heading text-sm tracking-wide">
          プロフィールを見る &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 5: News -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="recent-news">
    <header class="reveal mb-10 max-w-prose md:mb-14">
      <h2
        id="recent-news"
        class="font-display text-3xl font-medium tracking-tight text-charcoal md:text-4xl"
      >
        最新News
      </h2>
    </header>
    <ul>
      {recentNews.map((item) => <NewsItem item={item} />)}
    </ul>
    <div class="reveal mt-10">
      <a href="/news/" class="link-amber font-heading text-sm tracking-wide">
        ニュース一覧へ &rarr;
      </a>
    </div>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
