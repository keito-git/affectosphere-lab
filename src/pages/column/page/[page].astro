---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ColumnList from "../../../components/ColumnList.astro";
import Pagination from "../../../components/Pagination.astro";

export async function getStaticPaths() {
  const PAGE_SIZE = 15;
  const allPosts = (await getCollection("column-ja", (p) => !p.data.draft)).sort((a, b) =>
    b.data.date.localeCompare(a.data.date)
  );
  const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
  // Page 1 lives at /column/; only pages 2..N are generated here.
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        page,
        totalPages,
      },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---

<BaseLayout
  title={`Column (${page}/${totalPages})`}
  description="Affectosphere Group の論文を、背景・実験・結果まで図表と一緒に解説する研究ブログです。"
  fullBleed
>
  <PageHeader
    eyebrow="Column"
    title="論文を、書いた本人が解説する。"
    subtitle="Affectosphere Group の論文について、背景・実験・結果を図や表と一緒に解説します。"
    wideSubtitle
  />

  <section class="mx-auto mt-section-sm max-w-content page-x">
    <ColumnList posts={posts} hrefBase="/column" locale="ja" />
    <Pagination current={page} total={totalPages} basePath="/column" />
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
