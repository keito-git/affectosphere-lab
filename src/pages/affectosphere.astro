---
import BaseLayout from "../layouts/BaseLayout.astro";
import AffectospherePage from "../components/AffectospherePage.astro";
import Manifesto from "../components/Manifesto.astro";
// The manifesto is authored at the project root and imported at build time via
// Vite's `?raw` query, so editors update it without touching Astro code.
// @ts-ignore - Vite's ?raw import is not in the default type set.
import manifestoRaw from "../../MANIFESTO.md?raw";
---

<BaseLayout
  title="Affectosphereとは — 感情が社会を包む圏域"
  description="Affectosphere（情動圏）とは、感情が大気のように社会を包む圏域。空間の感情が追跡され、解析され、一人ひとりに最適化されて返る社会と、そこで守られるべき感情主権。"
  fullBleed
>
  <AffectospherePage locale="ja">
    <Manifesto src={manifestoRaw} locale="ja" />
  </AffectospherePage>
</BaseLayout>
