---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caiStages, stageStats } from "../data/research-map";
import { members } from "../data/people";
import Img from "../components/Img.astro";

// Grouped by role.  Until we have more people, only "Principal Investigator"
// has entries.  TODO(inoshita): add roles as collaborators / students join.
const groups: { label: string; key: string }[] = [
  { label: "Principal Investigator", key: "Principal Investigator" },
  { label: "Members", key: "Member" },
  { label: "Postdoctoral Researchers", key: "Postdoctoral Researcher" },
  { label: "Doctoral Students", key: "Doctoral Student" },
  { label: "Master's Students", key: "Master's Student" },
  { label: "Undergraduates", key: "Undergraduate" },
  { label: "Visiting Researchers", key: "Visiting Researcher" },
  { label: "Collaborators", key: "Collaborator" },
];

const populatedGroups = groups
  .map((g) => ({ ...g, people: members.filter((m) => m.role === g.key) }))
  .filter((g) => g.people.length > 0);

function initials(name: string): string {
  return name
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}

// The two thinnest stages on the research map, with what we want help on.
// Counts come from the map, so this section cannot drift out of date.
const _stats = stageStats();
const WANTED: Record<string, string> = {
  interaction:
    "人と AI が感情を介して往復する場の設計。自己省察の支援、対話インタフェース、共在をどう評価するか。立ち上がったばかりの段です。",
  "human-affect":
    "そもそも人が感情をどう経験し、どこで食い違うのか。心理学・認知科学の側から、計算の手前にある問いを一緒に立てられる方を探しています。",
  representation:
    "読み取った感情を、確率分布と不確実性のまま持ち続けるための表現。ベイズ・較正・ソフトラベルまわり。",
};
const thinStages = caiStages
  .map((stage) => ({ stage, total: _stats[stage.id].total, wanted: WANTED[stage.id] }))
  .filter((s) => s.wanted)
  .sort((a, b) => a.total - b.total);
---

<BaseLayout
  title="Member"
  description="Members of Affectosphere Group."
  fullBleed
>
  <section class="mx-auto max-w-content page-x pt-24 md:pt-32">
    <h1
      class="reveal font-display font-medium tracking-tight text-charcoal"
      style="font-size: clamp(2.25rem, 4.5vw, 4rem); line-height: 1.12;"
    >
      Member
    </h1>
    <p class="reveal mt-6 font-display text-lg leading-relaxed text-slate md:text-xl">
      Affectosphere Group は小さなチームとして始まっています。
      メンバー・客員研究員・共同研究者は順次このページに掲載されます。
    </p>
  </section>

  {
    populatedGroups.map((group) => (
      <section class="mx-auto mt-section-sm max-w-content page-x" aria-labelledby={`group-${group.key}`}>
        <h2
          id={`group-${group.key}`}
          class="reveal mb-8 font-heading text-2xl font-medium tracking-tight text-charcoal md:text-3xl"
        >
          {group.label}
        </h2>

        <!-- Grid is intentionally sparse: future members slot into the same
             4-column layout without any layout migration. -->
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {group.people.map((p) => (
            <article class="surface-card reveal flex h-full flex-col !p-4">
              <!-- Portrait slot.  Render initials block until a portrait
                   image is supplied. -->
              {p.portrait ? (
                <Img src={p.portrait} alt={`Portrait of ${p.name}`} class="aspect-square w-full border border-stone object-cover" />
              ) : (
                <div class="flex aspect-square w-full items-center justify-center border border-stone bg-ivory">
                  <span class="font-display text-4xl text-charcoal/30">
                    {initials(p.name)}
                  </span>
                </div>
              )}

              <div class="mt-4 flex flex-1 flex-col">
                <p class="font-sans text-[0.6rem] uppercase tracking-[0.14em] text-slate font-medium">
                  {p.role}
                </p>
                <h3 class="mt-1.5 font-heading text-base font-medium text-charcoal">
                  {p.name}
                  {p.nameJa && (
                    <span class="ml-1.5 font-display text-sm text-slate">
                      ({p.nameJa})
                    </span>
                  )}
                </h3>
                <p class="mt-1.5 text-[0.65rem] leading-snug text-slate">{p.affiliation}</p>
                <p class="mt-2.5 text-xs leading-relaxed text-charcoal/85">
                  {p.blurb}
                </p>

                {p.href && (
                  <div class="mt-auto pt-4">
                    <a
                      href={p.href}
                      class="link-amber font-heading text-xs tracking-wide"
                      target={p.href.startsWith("http") ? "_blank" : undefined}
                      rel={p.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    >
                      {p.href.startsWith("http") ? "個人サイト →" : "Details →"}
                    </a>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <!-- What we are looking for. Driven by the research map: the stages with the
       least behind them are the ones we most need people on. -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="collab">
    <div class="grid gap-10 md:grid-cols-[16rem_1fr] md:gap-14">
      <div>
        <p class="eyebrow reveal">Open positions</p>
        <h2
          id="collab"
          class="reveal mt-3 font-display text-2xl font-medium text-charcoal md:text-3xl"
        >
          いま、人を探している場所。
        </h2>
      </div>
      <div>
        <p class="reveal font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.85;">
          研究の地図で薄い段が、そのまま募集している場所です。
          埋まっている場所より、空いている場所のほうが面白いと思っています。
        </p>

        <ul class="reveal mt-10 divide-y divide-stone border-t border-stone">
          {
            thinStages.map((s) => (
              <li class="grid gap-2 py-6 md:grid-cols-[13rem_1fr] md:gap-8">
                <div>
                  <p class="font-label text-[0.78rem] uppercase tracking-[0.14em] text-amber-deep">
                    {s.stage.label}
                  </p>
                  <p class="mt-0.5 font-display text-base text-charcoal">{s.stage.labelJa}</p>
                  <p class="mt-1 font-label text-[0.72rem] tracking-[0.12em] text-slate">
                    業績 {s.total} 件
                  </p>
                </div>
                <p class="font-display text-base leading-relaxed text-slate">{s.wanted}</p>
              </li>
            ))
          }
        </ul>

        <div class="reveal mt-12">
          <p class="eyebrow">Who we work with</p>
          <ul class="mt-5 space-y-4">
            <li class="grid gap-1.5 md:grid-cols-[9rem_1fr] md:gap-6">
              <p class="font-display text-base font-medium text-charcoal">学生</p>
              <p class="font-display text-base leading-relaxed text-slate">
                学部・修士・博士いずれも。研究テーマは、上の地図から一緒に選びます。
              </p>
            </li>
            <li class="grid gap-1.5 md:grid-cols-[9rem_1fr] md:gap-6">
              <p class="font-display text-base font-medium text-charcoal">共同研究者</p>
              <p class="font-display text-base leading-relaxed text-slate">
                心理学・認知科学・HCI・倫理学など、AI の外側に軸足がある方ほど噛み合います。
              </p>
            </li>
            <li class="grid gap-1.5 md:grid-cols-[9rem_1fr] md:gap-6">
              <p class="font-display text-base font-medium text-charcoal">企業</p>
              <p class="font-display text-base leading-relaxed text-slate">
                実装先と、実際のデータ。感情 AI を現場に置くための条件を一緒に探せる相手を探しています。
              </p>
            </li>
          </ul>
        </div>

        <p class="reveal mt-10">
          <a href="/contact/" class="btn-solid">
            相談してみる
            <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- TODO(inoshita): when the lab gains its first additional member,
       populate `src/data/people.ts` with their entry and they will
       automatically appear in the relevant group above. -->

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
