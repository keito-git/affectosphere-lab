---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import SubjectOfEmotion from "../../components/SubjectOfEmotion.astro";
import NewsPanel from "../../components/NewsPanel.astro";
import { allNews } from "../../data/news.en";
import Img from "../../components/Img.astro";
import EmotionBoard from "../../components/EmotionBoard.astro";
---

<BaseLayout fullBleed locale="en">
  <Hero locale="en" />

  <!-- Section 2: the two fields, told through where the subject of emotion sits -->
  <SubjectOfEmotion locale="en" />

  <!-- Section 3: Principal Investigator -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="pi-intro">
    <div class="reveal border border-stone bg-white p-6 md:p-10">
      <div class="grid gap-8 md:grid-cols-[18rem_1fr] md:gap-12">
        <div>
          <!-- The portrait read the way the lab reads a face: a detection
               frame over it, an estimate beside it. The estimate is an
               illustration of the method, not a measurement of the person. -->
          <div class="relative aspect-square w-full overflow-hidden border border-stone bg-cream">
            <Img src="/people/keito-inoshita.jpg" alt="Keito Inoshita" class="h-full w-full object-cover" />
            <span class="pointer-events-none absolute inset-[12%] border border-amber/70" aria-hidden="true">
              <span class="absolute -left-px -top-px h-3 w-3 border-l-2 border-t-2 border-amber"></span>
              <span class="absolute -right-px -top-px h-3 w-3 border-r-2 border-t-2 border-amber"></span>
              <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-amber"></span>
              <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-amber"></span>
            </span>
            <span
              class="pointer-events-none absolute left-2 top-2 bg-ivory/85 px-1.5 py-0.5 font-label
                     text-[0.55rem] uppercase tracking-[0.14em] text-amber-deep"
              aria-hidden="true">face 01</span>
          </div>
          <div class="mt-3"><EmotionBoard locale="en" /></div>
        </div>

        <div>
          <p class="font-display text-lg italic tracking-wide text-slate">
            Principal Investigator
          </p>
          <h2
            id="pi-intro"
            class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
          >
            Keito Inoshita
          </h2>

          <div
            class="mt-6 space-y-5 font-display text-lg leading-relaxed text-charcoal md:text-xl"
            style="line-height: 1.72;"
          >
            <p>
              Works in two fields: affective computing, which analyses human emotion, and CAI,
              which gives an AI something affective of its own.
            </p>
            <p>
              There are two reasons for an AI to hold something affective. The first is that it
              can then understand human emotion more deeply and act on that understanding. An AI
              in the Affectosphere era will need to do this.
            </p>
            <p>
              The second is that the AI's own intelligence widens. With something like subjective
              feeling, that intelligence diverges and diversifies, which may lead to new ideas
              and discoveries.
            </p>
            <p>
              Affiliated with the Graduate School of Business Administration at Kansai University,
              the Data Science and AI Innovation Research Center at Shiga University, and the Japan
              Safety Society Research Center, with deployment pursued in parallel through
              collaborations with a wide range of companies.
            </p>
          </div>

          <p class="mt-8">
            <a href="/en/about/" class="link-amber font-heading text-sm tracking-wide">
              View profile &rarr;
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Looking for collaborators -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="lp-collab"
  >
    <div class="reveal border-l-2 border-amber/60 pl-6">
      <p class="font-display text-sm italic text-slate mb-3">Looking for collaborators</p>
      <h2
        id="lp-collab"
        class="font-display text-2xl font-medium text-charcoal md:text-3xl"
      >
        We are recruiting collaborators in CAI and affective computing
      </h2>
      <p class="mt-4 font-display text-base leading-relaxed text-charcoal md:text-lg">
        Either field is fine. Researchers and students, people who want to build a business,
        companies thinking about deployment, and anyone in art or expression who wants to work
        with emotion and AI are all welcome, whatever their field or age.
      </p>
      <p class="mt-6">
        <a href="/en/contact/" class="link-amber font-heading text-sm tracking-wide">
          Contact us &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 5: News -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="recent-news">
    <header class="reveal mb-8 max-w-prose md:mb-10">
      <h2
        id="recent-news"
        class="font-display text-3xl font-medium tracking-tight text-charcoal md:text-4xl"
      >
        News
      </h2>
    </header>
    <NewsPanel items={allNews} locale="en" />
    <div class="reveal mt-8">
      <a href="/en/news/" class="link-amber font-heading text-sm tracking-wide">
        See all news &rarr;
      </a>
    </div>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
