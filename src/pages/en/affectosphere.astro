---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffectospherePage from "../../components/AffectospherePage.astro";
import Manifesto from "../../components/Manifesto.astro";
// @ts-ignore - Vite's ?raw import is not in the default type set.
import manifestoRaw from "../../../MANIFESTO.en.md?raw";
---

<BaseLayout
