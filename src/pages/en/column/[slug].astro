---
import { getCollection, type CollectionEntry } from "astro:content";
import ColumnArticle from "../../../components/ColumnArticle.astro";

export async function getStaticPaths() {
  const posts = await getCollection("column-en", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<"column-en"> };
const { post } = Astro.props;
const hasOther = (await getCollection("column-ja", (p) => !p.data.draft)).some(
  (p) => p.slug === post.slug
);
---

<ColumnArticle post={post} locale="en" hasOther={hasOther} />
