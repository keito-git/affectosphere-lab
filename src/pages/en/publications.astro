---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationsPage from "../../components/PublicationsPage.astro";
import { allPublications } from "../../data/publications.en";

// The publication list as structured data, so a search engine reads this as a
// body of scholarly work rather than a page of text. Only fields the list
// actually holds are emitted.
const publicationsLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Publications — Affectosphere Group",
  numberOfItems: allPublications.length,
  itemListElement: allPublications.map((pub, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "ScholarlyArticle",
      name: pub.title,
      author: pub.authors.split(",").map((a) => ({ "@type": "Person", name: a.trim() })),
      datePublished: pub.date,
      publisher: pub.venue,
      ...(pub.href ? { url: pub.href, sameAs: pub.href } : {}),
    },
  })),
};
---

<BaseLayout
  jsonLd={publicationsLd}
  title="Publications — CAI and LLM research"
  description="All publications by Affectosphere Group, newest first, filterable by kind and year."
  fullBleed
  locale="en"
>
  <PublicationsPage locale="en" />
</BaseLayout>
