---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ColumnList from "../../components/ColumnList.astro";
import Pagination from "../../components/Pagination.astro";

const PAGE_SIZE = 15;

const allPosts = (await getCollection("column-en", (p) => !p.data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="Column"
  description="Long-form research posts on Affectosphere Group's papers: background, experiments and results, with figures and tables."
  fullBleed
  locale="en"
>
  <PageHeader
    eyebrow="Column"
    title="Our papers, explained by their authors."
    subtitle="Long-form posts on Affectosphere Group's papers: the background, the experiments and the results, with figures and tables."
    wideSubtitle
  />

  <section class="mx-auto mt-section-sm max-w-content page-x">
    {
      posts.length === 0 ? (
        <div class="reveal max-w-prose">
          <p class="font-display text-lg leading-relaxed text-charcoal md:text-xl" style="line-height: 1.72;">
            Posts are in preparation.
          </p>
          <p class="mt-4 font-display text-base leading-relaxed text-slate md:text-lg">
            Detailed posts on each paper's background, experiments and results will appear here.
          </p>
          <p class="mt-8">
            <a href="/en/research/" class="link-amber font-heading text-sm tracking-wide">
              See the research &rarr;
            </a>
          </p>
        </div>
      ) : (
        <ColumnList posts={posts} hrefBase="/en/column" locale="en" />
      )
    }
    {allPosts.length > 0 && (
      <Pagination current={1} total={totalPages} basePath="/en/column" />
    )}
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
