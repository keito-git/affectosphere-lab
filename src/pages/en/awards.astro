---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { awardGroups } from "../../data/awards.en";
import Img from "../../components/Img.astro";
import StatPanel from "../../components/StatPanel.astro";

// Format YYYY-MM-DD as "2026.06" (we only know month accuracy for most items).
// Summary figures, derived from the list itself.
const allAwards = awardGroups.flatMap((g) => g.items);
const awardYears = [...new Set(allAwards.map((a) => Number(a.date.slice(0, 4))))].sort();

// Ranks are written as they appear on each certificate, so they are grouped
// into the tiers a reader can actually compare. Anything not matching falls to
// "other" rather than being forced into a tier.
const RANK_TIERS: { label: string; labelJa: string; test: (r: string) => boolean }[] = [
  { label: "Best Paper", labelJa: "Best Paper", test: (r) => /best paper/i.test(r) },
  { label: "Grand prize", labelJa: "最優秀・大賞", test: (r) => /最優秀|大賞/.test(r) },
  { label: "Excellence", labelJa: "優秀賞", test: (r) => /優秀賞/.test(r) },
  { label: "Encouragement", labelJa: "奨励賞", test: (r) => /奨励賞/.test(r) },
];
const rankRows = (() => {
  const counted = RANK_TIERS.map((t) => ({
    label: t.label,
    value: allAwards.filter((a) => a.rank && t.test(a.rank)).length,
  })).filter((r) => r.value > 0);
  const placed = counted.reduce((n, r) => n + r.value, 0);
  const rest = allAwards.length - placed;
  return rest > 0 ? [...counted, { label: "Other", value: rest }] : counted;
})();

const groupRows = awardGroups.map((g) => ({ label: g.label, value: g.items.length }));
const yearRows = awardYears.map((y) => ({
  label: String(y),
  value: allAwards.filter((a) => a.date.startsWith(String(y))).length,
}));
const bestPaperCount = allAwards.filter((a) => a.rank && /best paper/i.test(a.rank)).length;

function formatYM(iso: string): string {
  const [y, m] = iso.split("-");
  return `${y}.${m}`;
}
---

<BaseLayout
  title="Awards — seven Best Paper Awards and more"
  description="Awards and honors received by the principal investigator."
  fullBleed
  locale="en"
>
  <section class="mx-auto max-w-content page-x pt-24 md:pt-32">
    <h1
      class="reveal font-display font-medium tracking-tight text-charcoal"
      style="font-size: clamp(2.25rem, 4.5vw, 4rem); line-height: 1.12;"
    >
      Awards
    </h1>
  </section>

  <section class="mx-auto mt-section-sm max-w-content page-x" aria-label="Summary">
    <StatPanel
      headline={allAwards.length}
      headlineLabel="awards"
      headlineNote={`${Math.min(...awardYears)} — ${Math.max(...awardYears)}`}
      highlights={[{ label: "Best Paper Award", value: bestPaperCount }]}
      groups={[
        { title: "By tier", rows: rankRows },
        { title: "By year", rows: yearRows },
      ]}
    />
  </section>

  {
    awardGroups.map((group) => (
      <section
        class="mx-auto mt-section-sm max-w-content page-x"
        aria-labelledby={`award-group-${group.key}`}
      >
        <h2
          id={`award-group-${group.key}`}
          class="reveal mb-6 font-display text-2xl font-medium text-charcoal md:text-3xl"
        >
          {group.label}
          <span class="ml-3 font-display text-base italic text-slate">
            {group.items.length} entries
          </span>
        </h2>
        <ul class="w-full">
          {group.items.map((a) => (
            <li class="reveal border-b border-stone py-5 last:border-b-0">
              <div class="grid gap-4 md:grid-cols-[7rem_8rem_1fr] md:items-start md:gap-6">
                <span class="font-display text-sm italic text-slate md:pt-1">
                  {formatYM(a.date)}
                </span>
                {a.image ? (
                  <a
                    href={a.image}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block overflow-hidden border border-stone bg-cream transition-shadow hover:shadow-card-hover"
                    aria-label={`Open certificate for ${a.title}`}
                  >
                    <Img src={a.image} alt={`Certificate for ${a.title}`} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                  </a>
                ) : (
                  <div aria-hidden="true" />
                )}
                <div>
                  <p class="font-display text-base text-charcoal md:text-lg">
                    {a.title}
                    {a.rank && (
                      <span class="ml-2 text-amber-deep">{a.rank}</span>
                    )}
                  </p>
                  {a.paperTitle && (
                    <p class="mt-1 font-display text-sm leading-relaxed text-charcoal/85 md:text-base">
                      {a.paperTitle}
                    </p>
                  )}
                  {a.paperAuthors && (
                    <p class="mt-1 font-display text-xs italic text-slate md:text-sm">
                      {a.paperAuthors}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
