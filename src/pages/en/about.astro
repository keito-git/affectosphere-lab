---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Img from "../../components/Img.astro";

// Education timeline (researchmap, 2026-05-30).  Newest at top.
const education = [
  {
    period: "2025/04 — present",
    degree: "Doctoral Program",
    program: "Graduate School of Business Administration, Major in Commerce",
    institution: "Kansai University",
  },
  {
    period: "2023/04 — 2025/03",
    degree: "M.Sc. in Data Science",
    program: "Graduate School of Data Science, Master's Program",
    institution: "Shiga University",
  },
  {
    period: "2020/04 — 2023/03",
    degree: "(withdrew for early admission to graduate school)",
    program: "School of Regional Innovation, Major in Business Administration",
    institution: "Sapporo University",
    note: "Withdrew at the end of the third year for early admission to graduate school.",
  },
];

// Current affiliations & research positions (researchmap).
const affiliations = [
  {
    period: "2025/04 — present",
    affiliation:
      "Kansai University, Graduate School of Business Administration, Major in Commerce",
    role: "Doctoral Program",
  },
  {
    period: "2025/04 — present",
    affiliation:
      "Shiga University, Data Science and AI Innovation Research Center",
    role: "Visiting Researcher",
  },
  {
    period: "2025/04 — present",
    affiliation: "Japan Safety Society Research Center",
    role: "Researcher",
  },
  {
    period: "2025/12 — 2026/03",
    affiliation:
      "Ritsumeikan University, Ritsumeikan Global Innovation Research Organization",
    role: "Visiting Researcher",
  },
  {
    period: "2025/04 — present",
    affiliation:
      "JST Support for Pioneering Research Initiated by the Next Generation (SPRING)",
    role: "Kansai University SPRING Scholarship Research Student",
  },
];

// "2025/04 — present" -> "2025.04 – present", so the column lines up with the
// period column used on the Grants list.
function formatPeriod(period: string): string {
  return period
    .split(/\s*[\u2013\u2014]\s*/)
    .map((part) => {
      const m = part.trim().match(/^(\d{4})\s*\/\s*(\d{1,2})$/);
      return m ? `${m[1]}.${m[2].padStart(2, "0")}` : part.trim();
    })
    .join(" \u2013 ");
}

// External profile links.
const links = [
  { label: "researchmap", href: "https://researchmap.jp/keito_inoshita" },
  { label: "ORCID", href: "https://orcid.org/0009-0006-6854-7231" },
  { label: "X (Twitter)", href: "https://x.com/keito0data" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  },
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://lab.affectosphere.group/about/#person",
  name: "Keito Inoshita",
  alternateName: "井下 敬翔",
  url: "https://lab.affectosphere.group/about/",
  jobTitle: "計算的感情知能（Computational Affective Intelligence）研究者",
  description:
    "AI に感情知能を与える研究者。感情の読み取りから、保持・推論・生成・相互作用・社会への定着までを Computational Affective Intelligence というひと続きの体系として扱う。",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "関西大学 大学院商学研究科" },
    { "@type": "CollegeOrUniversity", name: "滋賀大学 データサイエンス・AIイノベーション研究推進センター" },
    { "@type": "Organization", name: "日本セーフティソサイエティ研究センター" },
  ],
  knowsAbout: [
    "Computational Affective Intelligence",
    "Affective Computing",
    "感情AI",
    "大規模言語モデル",
    "感情認識",
    "不確実性の定量化",
    "感情データ生成",
    "AI倫理",
  ],
  sameAs: [
    "https://researchmap.jp/keito_inoshita",
    "https://orcid.org/0009-0006-6854-7231",
    "https://x.com/keito0data",
    "https://www.linkedin.com/in/%E6%95%AC%E7%BF%94-%E4%BA%95%E4%B8%8B-25433834b/",
  ],
  worksFor: { "@id": "https://lab.affectosphere.group/#organization" },
};
---

<BaseLayout jsonLd={personLd}
  title="Keito Inoshita — Computational Affective Intelligence researcher"
  description="Keito Inoshita — principal investigator of Affectosphere Group. Bio, education, research interests, and links."
  fullBleed
  locale="en"
>
  <!-- Header on the dark observation surface, as on the other sections. -->
  <section class="surface-ink relative overflow-hidden" aria-labelledby="about-heading">
    <div class="ink-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-content page-x pb-12 pt-16 md:pb-16 md:pt-20">
      <p class="eyebrow reveal">About</p>
      <h1
        id="about-heading"
        class="reveal mt-5 font-display font-semibold tracking-tight text-[#F4F2ED]"
        style="font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1;"
      >
        Keito Inoshita
      </h1>
      <p class="reveal mt-2 font-display text-[#CFCBC2]" style="font-size: clamp(0.95rem, 1.2vw, 1.2rem);">
        井下 敬翔
      </p>
      <p
        class="reveal mt-8 max-w-[72rem] font-display text-[#CFCBC2]"
        style="font-size: clamp(0.95rem, 1.1vw, 1.12rem); line-height: 1.72;"
      >
        Researcher in Computational Affective Intelligence. Founder, Affectosphere Group.
      </p>
    </div>
  </section>

  <!-- Identity card: portrait + short bio side by side. -->
  <section class="mx-auto mt-section max-w-content page-x" aria-labelledby="about-profile">
    <header class="reveal">
      <p class="eyebrow">01 &mdash; Profile</p>
      <h2
        id="about-profile"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        Profile
      </h2>
    </header>
    <div class="mt-10 grid gap-10 md:grid-cols-[18rem_minmax(0,1fr)] md:gap-14">
    <div class="reveal">
      <div class="aspect-square w-full overflow-hidden border border-stone bg-cream">
        <Img src="/people/keito-inoshita.jpg" alt="Keito Inoshita" class="h-full w-full object-cover" />
      </div>
      <p class="mt-4 font-sans text-[0.75rem] uppercase tracking-[0.14em] text-slate font-medium">
        Keito Inoshita
      </p>
    </div>

    <div>
      <p class="eyebrow reveal">Bio</p>
      <p
        id="bio"
        class="reveal mt-3 max-w-[46rem] font-display text-lg leading-relaxed text-charcoal md:text-xl"
        style="line-height: 1.72;"
      >
        He works on giving AI emotional intelligence, treating perception, representation,
        reasoning, generation, interaction and social placement as one continuous system &mdash;
        Computational Affective Intelligence (CAI).
        Affiliated with the Graduate School of Business Administration at Kansai University,
        the Data Science and AI Innovation Research Center at Shiga University,
        and the Japan Safety Society Research Center, he pursues research and development at the
        intersection of AI and emotion through collaborations with a wide range of companies.
        He founded the Affectosphere Group and works coherently across the generation,
        recognition, and understanding of human emotion with AI, on human-AI interaction,
        and on the ethics and philosophy of CAI.
        The ultimate aim is to realize AI endowed with an EQ that surpasses humans.
      </p>

      <p class="eyebrow reveal mt-12">Research Statement</p>
      <div class="reveal mt-3 max-w-[46rem] space-y-5 font-display text-base leading-relaxed text-charcoal md:text-lg" style="line-height: 1.72;">
        <p>
          The guiding question of his research is consistent:
          <em class="italic">how can AI engage with human emotion without diminishing its richness?</em>
          Emotion is ambiguous and polysemous, yet it shapes human judgment and relationships
          in every corner of society.
          Treating that ambiguity as an object of computation, rather than discarding it,
          is the starting point of his work.
        </p>
        <p>
          To this end, he conducts coherent research spanning the
          <em class="italic">generation, recognition, and understanding</em> of human emotion with AI,
          <em class="italic">human-AI interaction</em>, and the
          <em class="italic">ethics and philosophy of CAI</em>.
          Recognition becomes a technique for estimating ambiguity as a distribution;
          generation and expression form the interface where humans and AI converse through emotion;
          understanding reopens the question of how people experience emotion in the first place;
          and ethics and philosophy structurally reconsider the social positioning of CAI.
        </p>
        <p>
          Beyond academic work, through partnerships with diverse companies he incorporates
          field-level insight from the sites where CAI is deployed and reaches society
          into the foundation of his research.
          The aim is to draw the contours of AI endowed with an EQ that surpasses humans,
          through a back-and-forth between technology and the humanities, and between implementation and theory.
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Education -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="education"
  >
    <header class="reveal">
      <p class="eyebrow">02 &mdash; Education</p>
      <h2
        id="education"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        Education
      </h2>
    </header>
    <ul class="mt-10 border-t border-stone">
      {
        education.map((row) => (
          <li class="reveal grid gap-x-8 gap-y-3 border-b border-stone py-7 md:grid-cols-[11rem_minmax(0,1fr)] md:items-start">
            <span class="whitespace-nowrap font-label text-[0.72rem] tabular-nums tracking-[0.1em] text-slate">
              {formatPeriod(row.period)}
            </span>
            <div class="min-w-0">
              <h3 class="font-display text-lg leading-snug text-charcoal md:text-xl">
                {row.degree}
              </h3>
              <div class="mt-2.5 border-l border-amber/50 pl-3">
                <p class="font-display text-sm leading-relaxed text-charcoal/85 md:text-base">
                  {row.program}
                </p>
                <p class="mt-1 font-sans text-xs leading-relaxed text-slate md:text-sm">
                  {row.institution}
                </p>
              </div>
              {row.note && (
                <p class="mt-3 font-sans text-xs leading-relaxed text-slate md:text-sm">{row.note}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Affiliations -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="affiliations"
  >
    <header class="reveal">
      <p class="eyebrow">03 &mdash; Affiliations</p>
      <h2
        id="affiliations"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        Affiliations
      </h2>
    </header>
    <ul class="mt-10 border-t border-stone">
      {
        affiliations.map((a) => (
          <li class="reveal grid gap-x-8 gap-y-3 border-b border-stone py-7 md:grid-cols-[11rem_minmax(0,1fr)] md:items-start">
            <span class="whitespace-nowrap font-label text-[0.72rem] tabular-nums tracking-[0.1em] text-slate">
              {formatPeriod(a.period)}
            </span>
            <div class="min-w-0">
              <h3 class="font-display text-lg leading-snug text-charcoal md:text-xl">
                {a.affiliation}
              </h3>
              <p class="mt-2.5 border-l border-amber/50 pl-3 font-sans text-xs leading-relaxed text-slate md:text-sm">
                {a.role}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Links + CV -->
  <section
    class="mx-auto mt-section max-w-content page-x"
    aria-labelledby="links"
  >
    <header class="reveal">
      <p class="eyebrow">04 &mdash; Links</p>
      <h2
        id="links"
        class="mt-3 font-display text-3xl font-medium text-charcoal md:text-4xl"
      >
        Links
      </h2>
    </header>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 md:grid-cols-4">
      {
        links.map((l) => (
          <li class="reveal">
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="block border border-stone bg-cream px-4 py-3 font-display text-sm text-charcoal transition-colors hover:border-amber hover:text-amber-deep"
            >
              <span class="block">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
