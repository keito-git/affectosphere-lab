---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { allNews } from "../../../data/news.en";

export function getStaticPaths() {
  return allNews
    .filter((n) => n.slug)
    .map((n) => ({ params: { slug: n.slug }, props: { item: n } }));
}

const { item } = Astro.props;

const [y, m, d] = item.date.split("-");
const monthsEn = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const dateDisplay = `${monthsEn[Number(m) - 1]} ${Number(d)}, ${y}`;

const heading = item.title ?? item.body;
const others = allNews.filter((n) => n.slug && n.slug !== item.slug);
---

<BaseLayout title={heading} description={item.summary ?? item.body} locale="en">
  <PageHeader eyebrow={item.label} title={heading} compact />

  <article class="mx-auto mt-section-sm max-w-content page-x">
    <p class="reveal text-center font-sans text-sm text-slate">{dateDisplay}</p>

    <div class="reveal mt-8 flex flex-col items-center gap-4">
      <img
        src="/logo/wordmark.svg"
        alt="Affectosphere Group"
        width="360"
        height="62"
        class="h-14 w-auto md:h-16"
      />
      <div class="h-px w-16 bg-amber" aria-hidden="true"></div>
    </div>

    <div class="reveal mx-auto mt-10 max-w-prose">
      {item.summary && (
        <p class="font-display text-lg leading-relaxed text-charcoal" style="line-height: 1.9;">
          {item.summary}
        </p>
      )}

      {item.entries && item.entries.length > 0 && (
        <div class="mt-4 flex flex-col gap-8">
          {item.entries.map((e) => (
            <div class="border-t border-stone pt-6">
              <p class="eyebrow">{e.venue}</p>
              <h2 class="mt-2 font-display text-xl font-medium leading-snug text-charcoal md:text-2xl">
                {e.href ? (
                  <a href={e.href} class="link-amber">{e.title}</a>
                ) : (
                  e.title
                )}
              </h2>
              {e.authors && (
                <p class="mt-2 font-sans text-sm text-slate">{e.authors}</p>
              )}
              {e.summary && (
                <p class="mt-3 font-display text-base leading-relaxed text-charcoal" style="line-height: 1.85;">
                  {e.summary}
                </p>
              )}
            </div>
          ))}
        </div>
      )}

      {item.links && item.links.length > 0 && (
        <ul class="mt-8 flex flex-col gap-2">
          {item.links.map((l) => (
            <li>
              <a href={l.url} class="link-amber font-display text-base text-charcoal">
                {l.label} →
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="reveal mx-auto mt-section-sm max-w-prose border-t border-stone pt-8">
      <a href="/en/news/" class="link-amber font-display text-base text-charcoal">← Back to News</a>
      {others.length > 0 && (
        <ul class="mt-6 flex flex-col gap-2">
          {others.slice(0, 4).map((n) => (
            <li>
              <a href={`/en/news/${n.slug}/`} class="link-amber font-display text-sm text-slate">
                {n.title ?? n.body}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </article>

  <div class="h-section-sm" aria-hidden="true"></div>
</BaseLayout>
